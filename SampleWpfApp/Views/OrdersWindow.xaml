<Window x:Class="SampleWpfApp.Views.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:custom="clr-namespace:SampleWpfApp.CustomControls"
        Title="Sample WPF App — Orders" Height="380" Width="420"
        AutomationProperties.AutomationId="OrdersWindow">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="SKU"/>
        <ComboBox Grid.Row="1" x:Name="cmbSku"
                  AutomationProperties.AutomationId="cmbSku"
                  IsEditable="True" Margin="0,0,0,10">
            <ComboBoxItem Content="SKU-1001"/>
            <ComboBoxItem Content="SKU-2002"/>
            <ComboBoxItem Content="SKU-3003"/>
        </ComboBox>

        <Label Grid.Row="2" Content="Quantity"/>
        <TextBox Grid.Row="3" x:Name="txtQty" Text="1"
                 AutomationProperties.AutomationId="txtQty"
                 Margin="0,0,0,10"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Priority:" VerticalAlignment="Center"/>
            <!-- Custom-rendered control — no reliable AutomationId.
                 Only findable/drivable via WPFSpy (Name) or Sikuli
                 (image). See docs/SELF_HEALING_LOCATORS.md. -->
            <custom:PriorityToggleControl x:Name="chkPriority" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Vertical">
            <Button x:Name="btnCreateOrder" Content="Create Order"
                    AutomationProperties.AutomationId="btnCreateOrder"
                    Click="BtnCreateOrder_Click" Width="130" HorizontalAlignment="Left"/>
            <Label x:Name="lblConfirmation" Visibility="Collapsed" Margin="0,10,0,0" AutomationProperties.AutomationId="lblConfirmation"/>
            <Button x:Name="btnLogout" Content="Logout" Margin="0,10,0,0"
                    AutomationProperties.AutomationId="btnLogout"
                    Click="BtnLogout_Click" Width="80" HorizontalAlignment="Left"/>
        </StackPanel>

        <DataGrid Grid.Row="6" x:Name="gridOrders"
                  AutomationProperties.AutomationId="gridOrders"
                  AutoGenerateColumns="True" Margin="0,10,0,0" IsReadOnly="True"/>
    </Grid>
</Window>
