<UserControl x:Class="WpfTestIde.Docking.Views.ResultsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}">
    <!-- A6+E4 Step 3: extracted verbatim from MainWindow.xaml tabResults body (lines 533-630). 
         All AutomationIds and bindings preserved. -->
                <DockPanel Margin="6">
                    <!-- A7: per-tab toolbar for RESULTS. Re-runs / re-exports without
                         switching tabs. RESULTS deliberately uses DISTINCT AutomationIds
                         (btnResultsRerun / btnResultsExportScript / btnResultsReset) -
                         not the SCRIPTS-tab IDs (btnRunScript / btnExportScript /
                         btnSaveScript). Cross-tab AutomationId reuse would be unsafe:
                         WPF TabControls (no virtualization here) keep every TabItem's
                         content in the visual tree, so a reused AutomationId would
                         resolve ambiguously when repository/elements/wpf_test_ide.yaml
                         searches by relativeXPath="Button[@AutomationId='...']".
                         The commands themselves (RunCommand / ExportScriptCommand /
                         ResetCommand) are intentionally bound to multiple buttons -
                         that's safe because the AutomationIds, not the commands, are
                         the locators. -->
                    <Border DockPanel.Dock="Top" Style="{DynamicResource TabToolbarBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnResultsRerun" Style="{DynamicResource ToolbarButton}" Content="Run Again" ToolTip="Re-run the current script (F5)"
                                    Command="{Binding RunCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource StatusBarTextBrush}" AutomationProperties.AutomationId="btnResultsRerun"/>
                            <Separator Margin="8,0,4,0" VerticalAlignment="Center"/>
                            <Button x:Name="btnResultsExportScript" Style="{DynamicResource ToolbarButton}" Content="Export Script (.robot)"
                                    Command="{Binding ExportScriptCommand}" AutomationProperties.AutomationId="btnResultsExportScript"/>
                            <Button x:Name="btnResultsReset" Style="{DynamicResource ToolbarButton}" Content="Reset" ToolTip="Reload a fresh sample"
                                    Command="{Binding ResetCommand}" AutomationProperties.AutomationId="btnResultsReset"/>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="8" Margin="0,6,0,6" CornerRadius="3"
                             Background="{Binding LastRunSuccess, Converter={StaticResource BoolToStatusBrushConverter}}">
                        <TextBlock x:Name="txtRunSummary" Text="{Binding RunSummaryText}" FontFamily="Consolas" FontWeight="Bold" AutomationProperties.AutomationId="txtRunSummary"/>
                    </Border>
                    <!-- D4: log-level filter strip. Three independent toggles bound
                         to MainViewModel.ShowInfo/ShowWarn/ShowError (all ON by
                         default). The free-text search binds to LogSearchText.
                         All four re-pump RunOutputFiltered.CollectionView through
                         RefreshLogFilter on the VM side. Distinct AutomationIds so
                         repository locators + Robot tests can drive them. -->
                    <Border DockPanel.Dock="Top" Padding="6" Margin="0,0,0,6"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="INFO" IsChecked="{Binding ShowInfo, Mode=TwoWay}"
                                      Margin="0,0,12,0" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      ToolTip="Show INFO/TRACE/DEBUG lines and raw non-matching Robot output"
                                      AutomationProperties.AutomationId="chkLogLevelInfo"/>
                            <CheckBox Content="WARN" IsChecked="{Binding ShowWarn, Mode=TwoWay}"
                                      Margin="0,0,12,0" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      ToolTip="Show WARN lines"
                                      AutomationProperties.AutomationId="chkLogLevelWarn"/>
                            <CheckBox Content="ERROR" IsChecked="{Binding ShowError, Mode=TwoWay}"
                                      Margin="0,0,12,0" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      ToolTip="Show ERROR and FAIL lines"
                                      AutomationProperties.AutomationId="chkLogLevelError"/>
                            <Separator Margin="8,2" Background="{DynamicResource BorderBrush}" Width="1"/>
                            <TextBlock Text="🔍" Margin="8,0,4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="txtLogSearch"
                                     Width="220" Padding="4" FontSize="12"
                                     Text="{Binding LogSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Filter the Run Output ListView by any text in the raw line (case-insensitive)"
                                     AutomationProperties.AutomationId="txtLogSearch"/>
                        </StackPanel>
                    </Border>
                    <!-- D4: structured ListView replaces the txtRunOutput TextBox.
                         The TextBox + its AutomationId='txtRunOutput' are kept on
                         this ListView (AutomationProperties.AutomationId) so
                         existing repository/elements/wpf_test_ide.yaml +
                         Robot test locators still resolve —
                         "//ListView[@AutomationId='txtRunOutput']" (data file
                         updated in the same D4 change). Time/Level/Message
                         columns pinned at sensible widths; Message wraps so
                         long Robot lines do not push the columnar alignment
                         out the right edge. ItemsSource binds to the VM's
                         filtered CollectionView over the structured log. -->
                    <ListView x:Name="txtRunOutput"
                              ItemsSource="{Binding RunOutputFiltered, Mode=OneWay}"
                              FontFamily="Consolas" FontSize="11.5"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              AutomationProperties.AutomationId="txtRunOutput">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time" Width="160"
                                                DisplayMemberBinding="{Binding Time}"/>
                                <GridViewColumn Header="Level" Width="70"
                                                DisplayMemberBinding="{Binding LevelText}"/>
                                <GridViewColumn Header="Message" Width="600"
                                                DisplayMemberBinding="{Binding Message}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
</UserControl>