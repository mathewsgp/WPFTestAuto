<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted so the SAME agent code can run inside either a
         modern .NET (Core) WPF process or a .NET Framework one — these
         are two different, incompatible CLRs, so a target process can
         only ever load an assembly built for its own runtime. Both
         injection mechanisms (WpfSpyAgent.StartupHook for .NET,
         WpfSpyAgent.FrameworkHook for .NET Framework) each reference
         whichever build of THIS project matches their own TFM. -->
      <TargetFrameworks>net8.0-windows;net461</TargetFrameworks>
     <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WpfSpyAgent</AssemblyName>
    <RootNamespace>WpfSpyAgent</RootNamespace>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

   <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
      <!-- System.Text.Json 8.x is not compatible with .NET Framework;
           use Newtonsoft.Json for the net461 agent build. -->
      <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>

   <ItemGroup>
     <PackageReference Include="Tesseract" Version="4.1.1" />
   </ItemGroup>

</Project>
