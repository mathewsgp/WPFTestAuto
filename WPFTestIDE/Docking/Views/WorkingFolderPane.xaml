<UserControl x:Class="WpfTestIde.Docking.Views.WorkingFolderPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}">
    <DockPanel Margin="4">
        <!-- Toolbar: icon-only buttons -->
        <Border DockPanel.Dock="Top" Margin="0,4,0,4" Padding="4" Background="{DynamicResource PanelBrush}" CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnOpenFolder" ToolTip="Open Working Folder"
                        Command="{Binding OpenWorkingFolderCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource StatusBarTextBrush}" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="btnOpenFolder">
                    <TextBlock Text="📂" FontSize="14"/>
                </Button>
                <Button x:Name="btnRefreshFolder" ToolTip="Refresh Folder Tree"
                        Command="{Binding RefreshWorkingFolderCommand}" Background="{DynamicResource ButtonBackgroundBrush}" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="btnRefreshFolder">
                    <TextBlock Text="🔄" FontSize="14"/>
                </Button>
                <Button x:Name="btnImportSelected" ToolTip="Import Selected File"
                        Command="{Binding ImportWorkingFolderSelectedCommand}" Background="{DynamicResource ButtonBackgroundBrush}" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="btnImportSelected"
                        IsEnabled="{Binding CanImportSelected}">
                    <TextBlock Text="📥" FontSize="14"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- Folder Tree. The selected node's full path is shown as a tooltip so
             deep paths don't get clipped by the narrow pane width. -->
        <Border Padding="4" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
            <TreeView x:Name="FolderTreeView" ItemsSource="{Binding WorkingFolderRoot, Converter={StaticResource SingleItemToCollectionConverter}}"
                      SelectedItemChanged="FolderTreeView_SelectedItemChanged"
                      ToolTip="{Binding WorkingFolderPath}"
                      BorderThickness="0" Background="Transparent" AutomationProperties.AutomationId="FolderTreeView">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="1"/>
                        <Setter Property="ToolTip" Value="{Binding FullPath}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="1">
                            <TextBlock Text="{Binding Converter={StaticResource FolderItemIconConverter}}" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock VerticalAlignment="Center" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Name}"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding FileType}" FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>
    </DockPanel>
</UserControl>