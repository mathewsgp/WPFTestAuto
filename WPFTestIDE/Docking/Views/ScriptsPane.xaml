<UserControl x:Class="WpfTestIde.Docking.Views.ScriptsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}">
    <DockPanel Margin="6">
        <!-- Toolbar: Run, Save, Export, Apply, Import, Export Steps, Add Step, Checkpoint Wizard -->
        <Border DockPanel.Dock="Top" Style="{DynamicResource TabToolbarBorder}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnRunScript" Style="{DynamicResource ToolbarButton}" Content="Run Script" ToolTip="Run the current script (F5)"
                        Command="{Binding RunCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource StatusBarTextBrush}" AutomationProperties.AutomationId="btnRunScript"/>
                <Button x:Name="btnStopScript" Style="{DynamicResource ToolbarButton}" Content="Stop" ToolTip="Stop the current script run"
                        Command="{Binding CancelRunCommand}" AutomationProperties.AutomationId="btnStopScript"/>
                <Separator Margin="8,0,4,0" VerticalAlignment="Center"/>
                <Button x:Name="btnSaveExportScript" Style="{DynamicResource ToolbarButton}" Content="Save / Export Script" ToolTip="Save or export the current script (JSON / Python / Robot)"
                        Command="{Binding SaveExportScriptCommand}" AutomationProperties.AutomationId="btnSaveExportScript"/>
                <Separator Margin="8,0,4,0" VerticalAlignment="Center"/>
                <Button x:Name="btnApplyScript" Style="{DynamicResource ToolbarButton}" Content="Apply" ToolTip="Apply edits from the current view back to the step list"
                        Command="{Binding ApplyScriptCommand}" AutomationProperties.AutomationId="btnApplyScript"/>
                <Button x:Name="btnImportScript" Style="{DynamicResource ToolbarButton}" Content="Import" ToolTip="Import a script from .json, .py, or .robot file"
                        Command="{Binding ImportScriptCommand}" AutomationProperties.AutomationId="btnImportScript"/>
                <Separator Margin="8,0,4,0" VerticalAlignment="Center"/>
                <Button x:Name="btnAddStep" Style="{DynamicResource ToolbarButton}" Content="Add Step" Command="{Binding AddStepCommand}" AutomationProperties.AutomationId="btnAddStep"/>
                <Button x:Name="btnCheckpointWizard" Style="{DynamicResource ToolbarButton}" Content="Checkpoint Wizard" Command="{Binding OpenCheckpointWizardCommand}" AutomationProperties.AutomationId="btnCheckpointWizard"/>
            </StackPanel>
        </Border>

        <TabControl SelectedValuePath="Tag"
                    SelectedValue="{Binding CurrentScriptFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <!-- Tab 1: Visual (recorded steps list) -->
            <TabItem x:Name="tabVisualSteps" Header="Visual" Tag="Steps" AutomationProperties.AutomationId="tabVisualSteps">
                <ListBox x:Name="StepsListBox" ItemsSource="{Binding Steps}" ItemTemplate="{DynamicResource StepTemplate}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0,6,0,0" AutomationProperties.AutomationId="StepsListBox"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="StepsListBox_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="StepsListBox_PreviewMouseMove"
                         DragOver="StepsListBox_DragOver"
                         Drop="StepsListBox_Drop">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </TabItem>

            <!-- Tab 2: JSON Script -->
            <TabItem x:Name="tabJsonScript" Header="JSON" Tag="Json" AutomationProperties.AutomationId="tabJsonScript">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="JSON step list — edit and click Apply to sync across all views."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtJsonScript" Text="{Binding JsonScriptContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12"
                             TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Style="{DynamicResource VsCodeEditor}" AutomationProperties.AutomationId="txtJsonScript"/>
                </DockPanel>
            </TabItem>

            <!-- Tab 3: Python Script -->
            <TabItem x:Name="tabPythonScript" Header="Python Script" Tag="Python" AutomationProperties.AutomationId="tabPythonScript">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Python script using DriverAgnosticApi — edit and click Apply to sync across all views."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtPythonScript" Text="{Binding PythonScriptContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12"
                             TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Style="{DynamicResource VsCodeEditor}" AutomationProperties.AutomationId="txtPythonScript"/>
                </DockPanel>
            </TabItem>

            <!-- Tab 4: Robot Script -->
            <TabItem x:Name="tabRobotScript" Header="Robot Script" Tag="Robot" AutomationProperties.AutomationId="tabRobotScript">
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Top" Text="Robot Framework script using DriverAgnosticApi — edit and click Apply to sync across all views."
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="txtRobotScript" Text="{Binding RobotScriptContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12"
                             TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Style="{DynamicResource VsCodeEditor}" AutomationProperties.AutomationId="txtRobotScript"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
