<UserControl x:Class="WpfTestIde.Docking.Views.ScriptsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}">
    <UserControl.Resources>
        <Style x:Key="PaletteButton" TargetType="Button">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="6">
        <!-- Toolbar: G1 Execute | G2 File I/O | G3 Sync (compact top row) | G4 Build/Author palette (separate vertical strip on right) -->
        <!-- Palette docked Right so it does not inflate the toolbar row height; Groups 1-3 stay compact at top. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Vertical" VerticalAlignment="Top" Margin="8,0,0,0">
            <TextBlock Text="Add action" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <Button x:Name="btnAddStep" Style="{StaticResource PaletteButton}" Content="Add Action…" Command="{Binding AddStepCommand}" ToolTip="Add an action step (click, set text, verify…)" AutomationProperties.AutomationId="btnAddStep"/>
            <Separator Margin="0,8"/>
            <TextBlock Text="Add control flow" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <Button Style="{StaticResource PaletteButton}" Content="If / Else" Command="{Binding AddIfCommand}" ToolTip="Add a conditional block"/>
            <Button Style="{StaticResource PaletteButton}" Content="Repeat" Command="{Binding AddRepeatCommand}" ToolTip="Add a fixed-count loop (maximum 1000)"/>
            <Button Style="{StaticResource PaletteButton}" Content="For Each" Command="{Binding AddForEachCommand}" ToolTip="Add a bounded loop over values"/>
            <Separator Margin="0,8"/>
            <TextBlock Text="Configure" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
            <Button Style="{StaticResource PaletteButton}" Content="Datasets" Command="{Binding EditDatasetsCommand}" ToolTip="Edit named script datasets"/>
            <Button x:Name="btnCheckpointWizard" Style="{StaticResource PaletteButton}" Content="Checkpoint Wizard" Command="{Binding OpenCheckpointWizardCommand}" ToolTip="Open checkpoint wizard" AutomationProperties.AutomationId="btnCheckpointWizard"/>
        </StackPanel>
        <Border DockPanel.Dock="Top" Style="{DynamicResource TabToolbarBorder}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <!-- Group 1: Execute -->
                <Button x:Name="btnRunStopScript" Content="{Binding RunStopButtonLabel}" Click="BtnRunStopScript_Click" AutomationProperties.AutomationId="btnRunStopScript">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="Margin" Value="0,0,8,0"/>
                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource StatusBarTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScriptRunInProgress}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Separator Margin="8,0,4,0" VerticalAlignment="Center"/>
                <!-- Group 2: File I/O -->
                <Button x:Name="btnSaveScript" Style="{DynamicResource ToolbarButton}" Content="Save Script" ToolTip="Save the current script to its file (prompts for location on first save)"
                        Command="{Binding SaveScriptCommand}" AutomationProperties.AutomationId="btnSaveScript"/>
                <Button x:Name="btnExportScriptAs" Style="{DynamicResource ToolbarButton}" Content="Export Script As…" ToolTip="Export the current script to a new file (JSON / Python / Robot)"
                        Command="{Binding ExportScriptAsCommand}" AutomationProperties.AutomationId="btnExportScriptAs"/>
                <Button x:Name="btnLoadScriptFile" Style="{DynamicResource ToolbarButton}" Content="Load Script File…" ToolTip="Load a script file (.json / .py / .robot), replacing the current step list"
                        Command="{Binding ImportScriptCommand}" AutomationProperties.AutomationId="btnLoadScriptFile"/>
                <Separator Margin="8,0,4,0" VerticalAlignment="Center"/>
                <!-- Group 3: Sync -->
                <Button x:Name="btnApplyScript" Style="{DynamicResource ToolbarButton}" Content="Apply to Steps" ToolTip="Apply edits from the current script tab back to the Visual step list"
                        Command="{Binding ApplyScriptCommand}" AutomationProperties.AutomationId="btnApplyScript"/>
                <Separator Margin="8,0,4,0" VerticalAlignment="Center"/>
                <!-- View switcher (dropdown) -->
                <ComboBox x:Name="cmbScriptView" SelectedValue="{Binding CurrentScriptFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Width="130" VerticalAlignment="Center" AutomationProperties.AutomationId="cmbScriptView">
                    <ComboBoxItem Tag="Steps" Content="Visual"/>
                    <ComboBoxItem Tag="Json" Content="JSON"/>
                    <ComboBoxItem Tag="Python" Content="Python Script"/>
                    <ComboBoxItem Tag="Robot" Content="Robot Script"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Script view host: Visual / JSON / Python / Robot, switched by CurrentScriptFormat -->
        <Grid Margin="0,6,0,0">
            <!-- Visual (recorded steps list) -->
            <ListBox x:Name="StepsListBox" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep, Mode=TwoWay}" ItemTemplate="{DynamicResource StepTemplate}"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Margin="0,6,0,0" AutomationProperties.AutomationId="StepsListBox"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="StepsListBox_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="StepsListBox_PreviewMouseMove"
                     DragOver="StepsListBox_DragOver"
                     Drop="StepsListBox_Drop">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScriptFormat}" Value="Steps">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
            </ListBox>

            <!-- JSON Script -->
            <DockPanel Margin="0,6,0,0">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScriptFormat}" Value="Json">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <TextBlock DockPanel.Dock="Top" Text="JSON step list — edit and click Apply to sync across all views."
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtJsonScript" Text="{Binding JsonScriptContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Style="{DynamicResource VsCodeEditor}" AutomationProperties.AutomationId="txtJsonScript"/>
            </DockPanel>

            <!-- Python Script -->
            <DockPanel Margin="0,6,0,0">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScriptFormat}" Value="Python">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <TextBlock DockPanel.Dock="Top" Text="Python script using DriverAgnosticApi — edit and click Apply to sync across all views."
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtPythonScript" Text="{Binding PythonScriptContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Style="{DynamicResource VsCodeEditor}" AutomationProperties.AutomationId="txtPythonScript"/>
            </DockPanel>

            <!-- Robot Script -->
            <DockPanel Margin="0,6,0,0">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentScriptFormat}" Value="Robot">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <TextBlock DockPanel.Dock="Top" Text="Robot Framework script using DriverAgnosticApi — edit and click Apply to sync across all views."
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtRobotScript" Text="{Binding RobotScriptContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Style="{DynamicResource VsCodeEditor}" AutomationProperties.AutomationId="txtRobotScript"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
