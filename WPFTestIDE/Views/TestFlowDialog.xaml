<Window x:Class="WpfTestIde.Views.TestFlowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WpfTestIde.Models"
        Title="Visual Test Builder" Height="760" Width="1180" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <DataTemplate x:Key="FlowNodeTemplate" DataType="{x:Type models:RecordedStep}">
            <Border Padding="8" Margin="0,0,0,6" CornerRadius="4"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayVerb}" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <Button Content="↑" Padding="5,1" Margin="2,0" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Move up"/>
                        <Button Content="↓" Padding="5,1" Margin="2,0" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Move down"/>
                        <Button Content="×" Padding="5,1" Margin="2,0" Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Delete node"/>
                    </StackPanel>

                    <WrapPanel x:Name="GenericFields" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                        <TextBox Width="165" Margin="0,0,6,4" Text="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Element alias"/>
                        <TextBox Width="210" Margin="0,0,6,4" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Value or expected result"/>
                        <TextBox Width="120" Margin="0,0,6,4" Text="{Binding AppId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional app id"/>
                        <ComboBox Width="145" Margin="0,0,6,4" ItemsSource="{Binding DataContext.ActionKinds, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Action, Mode=TwoWay}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StepKind.Action}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </WrapPanel>

                    <StackPanel x:Name="IfEditor" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,4,0,0">
                        <TextBlock Text="IF" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <WrapPanel Margin="0,3,0,0">
                            <ComboBox Width="150" Margin="0,0,6,4" ItemsSource="{Binding DataContext.FlowConditionKinds, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Condition.Kind, Mode=TwoWay}"/>
                            <TextBox Width="160" Margin="0,0,6,4" Text="{Binding Condition.Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Element alias"/>
                            <TextBox Width="180" Margin="0,0,6,4" Text="{Binding Condition.ExpectedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Expected value for text conditions"/>
                            <TextBox Width="120" Margin="0,0,6,4" Text="{Binding Condition.AppId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional app id"/>
                            <CheckBox Content="Else branch" IsChecked="{Binding HasElse, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0,6,4"/>
                        </WrapPanel>
                        <DockPanel>
                            <TextBlock Text="THEN" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="+ Click" Padding="5,2" FontSize="10" Command="{Binding DataContext.AddThenStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="+ If" Padding="5,2" FontSize="10" Margin="3,0,0,0" Command="{Binding DataContext.AddNestedIfCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="+ Repeat" Padding="5,2" FontSize="10" Margin="3,0,0,0" Command="{Binding DataContext.AddNestedRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="+ Each" Padding="5,2" FontSize="10" Margin="3,0,0,0" Command="{Binding DataContext.AddNestedForEachCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ThenSteps}" ItemTemplate="{DynamicResource FlowNodeTemplate}" Margin="12,4,0,4"/>
                        <DockPanel Visibility="{Binding HasElse, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="ELSE" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="+ Click" Padding="5,2" FontSize="10" Command="{Binding DataContext.AddElseStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="+ If" Padding="5,2" FontSize="10" Margin="3,0,0,0" Command="{Binding DataContext.AddElseIfCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="+ Repeat" Padding="5,2" FontSize="10" Margin="3,0,0,0" Command="{Binding DataContext.AddElseRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="+ Each" Padding="5,2" FontSize="10" Margin="3,0,0,0" Command="{Binding DataContext.AddElseForEachCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding ElseSteps}" ItemTemplate="{DynamicResource FlowNodeTemplate}" Margin="12,4,0,4" Visibility="{Binding HasElse, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <StackPanel x:Name="RepeatEditor" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,4,0,0">
                        <WrapPanel>
                            <TextBlock Text="Repeat count (maximum 1000):" VerticalAlignment="Center" Margin="0,0,6,4"/>
                            <TextBox Width="80" Text="{Binding RepeatCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </WrapPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="BODY" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="+ Click" Padding="5,2" FontSize="10" Command="{Binding DataContext.AddLoopStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="+ If" Padding="5,2" FontSize="10" Margin="3,0,0,0" Command="{Binding DataContext.AddNestedIfCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="+ Repeat" Padding="5,2" FontSize="10" Margin="3,0,0,0" Command="{Binding DataContext.AddNestedRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="+ Each" Padding="5,2" FontSize="10" Margin="3,0,0,0" Command="{Binding DataContext.AddNestedForEachCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding BodySteps}" ItemTemplate="{DynamicResource FlowNodeTemplate}" Margin="12,4,0,4"/>
                    </StackPanel>

                    <StackPanel x:Name="ForEachEditor" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,4,0,0">
                        <WrapPanel>
                            <TextBlock Text="Variable" VerticalAlignment="Center" Margin="0,0,4,4"/>
                            <TextBox Width="90" Margin="0,0,6,4" Text="{Binding LoopVariable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <ComboBox Width="150" Margin="0,0,6,4" ItemsSource="{Binding DataContext.FlowLoopSourceKinds, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding LoopSourceKind, Mode=TwoWay}"/>
                            <ComboBox Width="150" Margin="0,0,6,4" ItemsSource="{Binding DataContext.DatasetNames, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding DatasetName, Mode=TwoWay}" Visibility="{Binding UsesNamedDataset, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBox Width="190" Height="46" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding LoopValuesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" ToolTip="Literal values, one per line"/>
                        </WrapPanel>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="BODY" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="+ Click" Padding="5,2" FontSize="10" Command="{Binding DataContext.AddLoopStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="+ If" Padding="5,2" FontSize="10" Margin="3,0,0,0" Command="{Binding DataContext.AddNestedIfCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="+ Repeat" Padding="5,2" FontSize="10" Margin="3,0,0,0" Command="{Binding DataContext.AddNestedRepeatCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                <Button Content="+ Each" Padding="5,2" FontSize="10" Margin="3,0,0,0" Command="{Binding DataContext.AddNestedForEachCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding BodySteps}" ItemTemplate="{DynamicResource FlowNodeTemplate}" Margin="12,4,0,4"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StepKind.If}"><Setter TargetName="GenericFields" Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StepKind.Repeat}"><Setter TargetName="GenericFields" Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StepKind.ForEach}"><Setter TargetName="GenericFields" Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StepKind.If}"><Setter TargetName="IfEditor" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StepKind.Repeat}"><Setter TargetName="RepeatEditor" Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:StepKind.ForEach}"><Setter TargetName="ForEachEditor" Property="Visibility" Value="Visible"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="PaletteButton" TargetType="Button">
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Visual Test Builder" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource StatusBarTextBrush}"/>
                    <TextBlock Text="Edit the same nested nodes used by JSON, Python, and Robot views." FontSize="11" Foreground="{DynamicResource StatusBarTextBrush}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Import script" Margin="4" Padding="8,4" Click="LoadSteps_Click"/>
                    <Button Content="Preview" Margin="4" Padding="8,4" Click="GenerateCode_Click"/>
                    <Button Content="Export" Margin="4" Padding="8,4" Click="SaveRobot_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Add action" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource PaletteButton}" Content="Click" Command="{Binding AddActionCommand}" CommandParameter="Click"/>
                        <Button Style="{StaticResource PaletteButton}" Content="Set Text" Command="{Binding AddActionCommand}" CommandParameter="Set Text"/>
                        <Button Style="{StaticResource PaletteButton}" Content="Toggle" Command="{Binding AddActionCommand}" CommandParameter="Toggle"/>
                        <Button Style="{StaticResource PaletteButton}" Content="Double Click" Command="{Binding AddActionCommand}" CommandParameter="Double Click"/>
                        <Button Style="{StaticResource PaletteButton}" Content="Right Click" Command="{Binding AddActionCommand}" CommandParameter="Right Click"/>
                        <Button Style="{StaticResource PaletteButton}" Content="Hover" Command="{Binding AddActionCommand}" CommandParameter="Hover"/>
                        <Button Style="{StaticResource PaletteButton}" Content="Verify Text" Command="{Binding AddActionCommand}" CommandParameter="Verify Text"/>
                        <Button Style="{StaticResource PaletteButton}" Content="Wait Visible" Command="{Binding AddActionCommand}" CommandParameter="Wait Visible"/>
                        <Separator Margin="0,8"/>
                        <TextBlock Text="Add control flow" FontWeight="Bold" Margin="0,0,0,6"/>
                        <Button Style="{StaticResource PaletteButton}" Content="If / Else" Command="{Binding AddIfCommand}"/>
                        <Button Style="{StaticResource PaletteButton}" Content="Repeat" Command="{Binding AddRepeatCommand}"/>
                        <Button Style="{StaticResource PaletteButton}" Content="For Each" Command="{Binding AddForEachCommand}"/>
                        <Button Style="{StaticResource PaletteButton}" Content="Clear flow" Command="{Binding ClearAllCommand}" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Test name" FontSize="10" FontWeight="Bold"/>
                            <TextBox Text="{Binding TestName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Description" FontSize="10" FontWeight="Bold"/>
                            <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Shared script nodes" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="  Datasets are available to For Each blocks." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Datasets" Padding="6,3" Margin="0,0,4,0" Click="EditDatasets_Click"/>
                                <Button Content="Flow diagram" Padding="6,3" Click="ShowFlowDiagram_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Steps}" ItemTemplate="{DynamicResource FlowNodeTemplate}"
                                 SelectedItem="{Binding SelectedStep, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="8" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="Top-level nodes: " VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Steps.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Padding="10,5" Margin="4,0" Click="Cancel_Click"/>
                    <Button Content="Use flow" Padding="12,5" Margin="4,0" Click="UseFlow_Click" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource StatusBarTextBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
