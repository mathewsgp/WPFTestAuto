<UserControl x:Class="WpfTestIde.Views.ElementEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WpfTestIde.Models"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="6" Background="{DynamicResource BackgroundBrush}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="btnSaveElement" Content="Save" Command="{Binding SaveElementCommand}" Padding="12,6" Margin="0,0,6,0"
                    Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource StatusBarTextBrush}" FontWeight="Bold"
                    AutomationProperties.AutomationId="btnSaveElement"/>
            <Button x:Name="btnCancelEdit" Content="Cancel" Command="{Binding CancelEditElementCommand}" Padding="12,6"
                    AutomationProperties.AutomationId="btnCancelEdit"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Element Properties" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" Foreground="{DynamicResource TextPrimaryBrush}"/>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource BackgroundBrush}">
                    <StackPanel>
                        <TextBlock Text="Identity" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Alias" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding EditingElement.Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementAliasBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Display Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding EditingElement.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementDisplayNameBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Control Type" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding EditingElement.ControlType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementControlTypeBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="App Id" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding EditingElement.AppId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementAppIdBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="AutomationId" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding EditingElement.AutomationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementAutomationIdBox"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding EditingElement.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementNameBox"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Metadata" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <TextBlock Text="Image Path (OculiX template, repo-relative)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding EditingElement.ImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementImagePathBox"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Strategies (separate per driver)" Style="{StaticResource SectionHeader}" Margin="0" DockPanel.Dock="Left"/>
                            <Button Content="+ Driver Group" Command="{Binding AddStrategyGroupCommand}" DockPanel.Dock="Right" Padding="8,2" Margin="8,0,0,0" AutomationProperties.AutomationId="btnAddStrategyGroup"/>
                        </DockPanel>
                        <TextBlock Text="Each group is emitted as a driver strategy array in repository JSON. Edit searchBy/value/scope/image fields as needed." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <ItemsControl ItemsSource="{Binding EditingElement.StrategyGroups}" AutomationProperties.AutomationId="StrategyGroupsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ElementStrategyGroup}">
                                    <Border BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8" Background="{DynamicResource BackgroundBrush}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="Enabled" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Text="{Binding Driver, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120" FontWeight="Bold" Margin="0,0,8,0" Padding="3" AutomationProperties.AutomationId="StrategyDriverName"/>
                                                <Button Content="+ Locator" Command="{Binding DataContext.AddStrategyItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,2" Margin="0,0,4,0"/>
                                                <Button Content="Remove Group" Command="{Binding DataContext.RemoveStrategyGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,2" DockPanel.Dock="Right"/>
                                            </DockPanel>

                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ElementStrategyItem}">
                                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,4,0,6" Margin="0,0,0,4">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="110"/>
                                                                    <ColumnDefinition Width="6"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="6"/>
                                                                    <ColumnDefinition Width="110"/>
                                                                    <ColumnDefinition Width="6"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                                    <TextBlock Text="searchBy" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                    <TextBox Text="{Binding SearchBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3" FontFamily="Consolas"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="0" Grid.Column="2">
                                                                    <TextBlock Text="value" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3" FontFamily="Consolas" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="24"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Row="0" Grid.Column="4">
                                                                    <TextBlock Text="scope / similarity" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                    <DockPanel>
                                                                        <TextBox Text="{Binding Scope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3" Width="54" Margin="0,0,4,0" ToolTip="scope (e.g. Descendant)"/>
                                                                        <TextBox Text="{Binding Similarity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3" ToolTip="similarity (OculiX)"/>
                                                                    </DockPanel>
                                                                </StackPanel>
                                                                <Button Grid.Row="0" Grid.Column="6" Content="✕" ToolTip="Remove locator"
                                                                        Command="{Binding DataContext.RemoveStrategyItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}" Padding="6,2" VerticalAlignment="Bottom"/>
                                                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,4,0,0">
                                                                    <TextBlock Text="imagePath (OculiX, optional)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                    <TextBox Text="{Binding ImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3" FontFamily="Consolas"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
