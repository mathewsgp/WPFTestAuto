<UserControl x:Class="WpfTestIde.Views.ElementEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WpfTestIde.Models"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PropName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,3,8,3"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="PropValue" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,2,4,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="6" Background="{DynamicResource BackgroundBrush}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="btnSaveElement" Content="Save" Command="{Binding SaveElementCommand}" Padding="12,5" Margin="0,0,6,0"
                    Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource StatusBarTextBrush}" FontWeight="Bold"
                    AutomationProperties.AutomationId="btnSaveElement"/>
            <Button x:Name="btnCancelEdit" Content="Cancel" Command="{Binding CancelEditElementCommand}" Padding="12,5"
                    AutomationProperties.AutomationId="btnCancelEdit"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="Properties" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Two-column property grid: Property | Value (simple text edit) -->
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BackgroundBrush}" Margin="0,0,0,8">
                    <Grid AutomationProperties.AutomationId="ElementPropertiesGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" MinWidth="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"/>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Property" FontWeight="SemiBold" Margin="6,4" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Value" FontWeight="SemiBold" Margin="6,4" Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Alias" Style="{StaticResource PropName}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PropValue}" Text="{Binding EditingElement.Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementAliasBox"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Display Name" Style="{StaticResource PropName}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource PropValue}" Text="{Binding EditingElement.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementDisplayNameBox"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Control Type" Style="{StaticResource PropName}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource PropValue}" Text="{Binding EditingElement.ControlType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementControlTypeBox"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="App Id" Style="{StaticResource PropName}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource PropValue}" Text="{Binding EditingElement.AppId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementAppIdBox"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="AutomationId" Style="{StaticResource PropName}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource PropValue}" Text="{Binding EditingElement.AutomationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementAutomationIdBox"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Name" Style="{StaticResource PropName}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource PropValue}" Text="{Binding EditingElement.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ElementNameBox"/>
                    </Grid>
                </Border>

                <Expander Header="Strategies" IsExpanded="True" Margin="0,0,0,8" AutomationProperties.AutomationId="StrategiesExpander">
                    <StackPanel Margin="0,6,0,0">
                        <DockPanel Margin="0,0,0,6">
                            <Button Content="+ Driver Group" Command="{Binding AddStrategyGroupCommand}" DockPanel.Dock="Right" Padding="8,2" Margin="8,0,0,0" AutomationProperties.AutomationId="btnAddStrategyGroup"/>
                            <TextBlock Text="Driver strategy groups (runtime priority fixed: UIA3 → WPFSpy → OculiX)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding EditingElement.StrategyGroups}" AutomationProperties.AutomationId="StrategyGroupsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ElementStrategyGroup}">
                                    <Border BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" Padding="6" Margin="0,0,0,6" Background="{DynamicResource BackgroundBrush}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="{Binding HeaderText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <ToggleButton Content="{Binding EditButtonText}" IsChecked="{Binding IsEditing, Mode=TwoWay}" DockPanel.Dock="Right" Padding="8,1" Margin="4,0,0,0" AutomationProperties.AutomationId="btnEditStrategyGroup"/>
                                                <Button Content="+ Locator" Command="{Binding DataContext.AddStrategyItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,1" Margin="0,0,4,0"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                                                <Button Content="Remove Group" Command="{Binding DataContext.RemoveStrategyGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,1"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                                            </DockPanel>

                                            <!-- Summary (shown when not editing) -->
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Two-column table view per locator (shown when editing) -->
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ElementStrategyItem}">
                                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,6" Background="{DynamicResource BackgroundBrush}">
                                                            <StackPanel>
                                                                <DockPanel Background="{DynamicResource SurfaceBrush}" Margin="0,0,0,2">
                                                                    <Button Content="✕" DockPanel.Dock="Right" ToolTip="Remove locator"
                                                                            Command="{Binding DataContext.RemoveStrategyItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}" Padding="6,1" Margin="4,2"/>
                                                                    <TextBlock Text="Locator" FontWeight="SemiBold" FontSize="11" Margin="6,3" VerticalAlignment="Center"/>
                                                                </DockPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="110" MinWidth="90"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"/>
                                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Property" FontWeight="SemiBold" FontSize="11" Margin="6,2"/>
                                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Value" FontWeight="SemiBold" FontSize="11" Margin="6,2"/>

                                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="searchBy" Style="{StaticResource PropName}"/>
                                                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PropValue}" Text="{Binding SearchBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="value" Style="{StaticResource PropName}"/>
                                                                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource PropValue}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="24"/>

                                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="scope" Style="{StaticResource PropName}"/>
                                                                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource PropValue}" Text="{Binding Scope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="imagePath" Style="{StaticResource PropName}"/>
                                                                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource PropValue}" Text="{Binding ImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

