<Window x:Class="WpfTestIde.Dialogs.AttachToProcessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attach to Process" Height="720" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        AutomationProperties.AutomationId="AttachToProcessDialog">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Mode Selection -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="RuntimeAttachRadio" Content="Runtime Attach (Already Running)" 
                        IsChecked="True" Margin="0,0,20,0" VerticalContentAlignment="Center"
                        Checked="RuntimeAttachRadio_Checked" AutomationProperties.AutomationId="RuntimeAttachRadio"/>
            <RadioButton x:Name="NewProcessRadio" Content="Launch New Process"
                        Margin="0,0,20,0" VerticalContentAlignment="Center"
                        Checked="NewProcessRadio_Checked" AutomationProperties.AutomationId="NewProcessRadio"/>
        </StackPanel>

        <!-- Runtime Attach Panel -->
        <Grid Grid.Row="1" x:Name="RuntimeAttachPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Select the target application's process:" 
                      Style="{StaticResource SectionHeader}"/>

            <ListView Grid.Row="1" x:Name="ProcessListView" Margin="0,0,0,8" AutomationProperties.AutomationId="ProcessListView">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="PID" Width="60" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Window Title" Width="280" DisplayMemberBinding="{Binding MainWindowTitle}"/>
                        <GridViewColumn Header="Process Name" Width="130" DisplayMemberBinding="{Binding ProcessName}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button x:Name="btnRefreshProcessList" Content="Refresh List" Click="RefreshProcessList_Click" 
                       Width="100" Margin="0,0,8,0" AutomationProperties.AutomationId="btnRefreshProcessList"/>
                <CheckBox x:Name="ShowAllProcessesCheck" Content="Show all processes" 
                         VerticalAlignment="Center" Margin="8,0,0,0"
                         Checked="ShowAllProcessesCheck_Changed"
                         Unchecked="ShowAllProcessesCheck_Changed" AutomationProperties.AutomationId="ShowAllProcessesCheck"/>
            </StackPanel>
        </Grid>

        <!-- Launch New Process Panel (scrollable) -->
        <ScrollViewer Grid.Row="1" x:Name="NewProcessPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Application ID (optional):" Margin="0,0,0,4"/>
                <TextBox x:Name="AppIdBox" Height="28" Margin="0,0,0,8"
                         AutomationProperties.AutomationId="AppIdBox"
                         ToolTip="Logical ID for this app, e.g. 'main', 'helper'. Leave empty for auto-generated ID."/>

                <TextBlock Text="Path to executable:" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="ApplicationPathBox" Height="28" Margin="0,0,8,0" AutomationProperties.AutomationId="ApplicationPathBox"/>
                    <Button Grid.Column="1" x:Name="btnBrowseApplication" Content="Browse..." Width="80" Click="BrowseApplication_Click" AutomationProperties.AutomationId="btnBrowseApplication"/>
                </Grid>

                <TextBlock Text="Start in (working directory, optional):" Margin="0,0,0,4"/>
                <TextBox x:Name="StartInBox" Height="28" Margin="0,0,0,8" AutomationProperties.AutomationId="StartInBox"/>

                <TextBlock Text="Command-line arguments (optional):" Margin="0,0,0,4"/>
                <TextBox x:Name="ArgumentsBox" Height="28" Margin="0,0,0,8" AutomationProperties.AutomationId="ArgumentsBox"/>

                <!-- Driver Selection -->
                <TextBlock Text="Available Drivers:" Margin="0,0,0,4"/>
                <ListBox x:Name="AvailableDriversList" Height="60" FontSize="11" Margin="0,0,0,4" AutomationProperties.AutomationId="AvailableDriversList"/>

                <TextBlock Text="Selected Drivers (priority order):" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,4">
                    <ListBox x:Name="SelectedDriversList" Height="60" FontSize="11" Margin="0,0,4,0" AutomationProperties.AutomationId="SelectedDriversList"/>
                    <StackPanel Orientation="Vertical" DockPanel.Dock="Right">
                        <Button x:Name="btnAddDriver" Content="Add &gt;" Padding="6,2" FontSize="10" Margin="0,0,0,1" AutomationProperties.AutomationId="btnAddDriver" Click="btnAddDriver_Click"/>
                        <Button x:Name="btnRemoveDriver" Content="&lt; Remove" Padding="6,2" FontSize="10" Margin="0,0,0,1" AutomationProperties.AutomationId="btnRemoveDriver" Click="btnRemoveDriver_Click"/>
                        <Button x:Name="btnDriverUp" Content="Up" Padding="6,2" FontSize="10" Margin="0,0,0,1" AutomationProperties.AutomationId="btnDriverUp" Click="btnDriverUp_Click"/>
                        <Button x:Name="btnDriverDown" Content="Down" Padding="6,2" FontSize="10" AutomationProperties.AutomationId="btnDriverDown" Click="btnDriverDown_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- Enable Spy Agent + conditional pipe name -->
                <CheckBox x:Name="EnableSpyAgentCheck" Content="Enable Spy Agent" Margin="0,0,0,4" IsChecked="True"
                          Checked="EnableSpyAgentCheck_Checked" Unchecked="EnableSpyAgentCheck_Checked"
                          AutomationProperties.AutomationId="EnableSpyAgentCheck"
                          ToolTip="Enable the in-process Spy Agent for this application."/>
                <StackPanel x:Name="PipeNamePanel" Margin="0,4,0,0">
                    <TextBlock Text="Pipe name (optional, for Spy Agent):" Margin="0,0,0,4"/>
                    <TextBox x:Name="PipeNameBox" Height="28" Text="WPFSpyAgentPipe"
                             AutomationProperties.AutomationId="PipeNameBox"
                             ToolTip="Named pipe for Spy Agent communication. Leave empty to use default."/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Status and Buttons -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusText" 
                      Style="{StaticResource StatusText}"
                      VerticalAlignment="Center" AutomationProperties.AutomationId="StatusText"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnAttachCancel" Content="Cancel" Width="80" Margin="0,0,8,0" 
                       Click="Cancel_Click" IsCancel="True" AutomationProperties.AutomationId="btnAttachCancel"/>
                <Button x:Name="btnAttach" Content="Attach" Width="100" Click="Attach_Click" 
                       IsDefault="True" Background="{DynamicResource InputBackgroundBrush}" AutomationProperties.AutomationId="btnAttach"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
