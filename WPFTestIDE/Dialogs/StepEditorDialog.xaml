<Window x:Class="WpfTestIde.Dialogs.StepEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:wpfTestIdeModels="clr-namespace:WpfTestIde.Models;assembly=WpfTestIde"
        Title="Edit Step" Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        AutomationProperties.AutomationId="StepEditorDialog">
    <Window.Resources>
        <ObjectDataProvider x:Key="StepKinds" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="wpfTestIdeModels:StepKind"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ActionKinds" MethodName="GetValues" ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="wpfTestIdeModels:ActionKind"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Kind -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Step Kind:" Margin="0,0,0,4" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="KindCombo" ItemsSource="{Binding Source={StaticResource StepKinds}}"
                  SelectedItem="{Binding ResultStep.Kind}" Margin="0,0,0,10" FontSize="11" SelectionChanged="KindCombo_SelectionChanged"
                  AutomationProperties.AutomationId="StepKindCombo"/>

        <!-- Action -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Action:" Margin="0,0,0,4" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ActionCombo" ItemsSource="{Binding Source={StaticResource ActionKinds}}"
                  SelectedItem="{Binding ResultStep.Action}" Margin="0,0,0,10" FontSize="11" SelectionChanged="ActionCombo_SelectionChanged"
                  AutomationProperties.AutomationId="StepActionCombo"/>

        <!-- Alias -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Alias:" Margin="0,0,0,4" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="AliasBox" Margin="0,0,0,10" FontSize="11" AutomationProperties.AutomationId="StepAliasBox"/>

        <!-- Value -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Value:" Margin="0,0,0,4" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="ValueBox" Margin="0,0,0,10" FontSize="11" AutomationProperties.AutomationId="StepValueBox"/>

        <!-- Attribute Name -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Attribute Name:" Margin="0,0,0,4" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="AttributeNameBox" Margin="0,0,0,10" FontSize="11" AutomationProperties.AutomationId="StepAttributeNameBox"/>

        <!-- Target Alias -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Target Alias:" Margin="0,0,0,4" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TargetAliasBox" Margin="0,0,0,10" FontSize="11" AutomationProperties.AutomationId="StepTargetAliasBox"/>

        <!-- Property Name -->
        <TextBlock Grid.Row="6" Grid.Column="0" Text="Property Name:" Margin="0,0,0,4" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="PropertyNameBox" Margin="0,0,0,10" FontSize="11" AutomationProperties.AutomationId="StepPropertyNameBox"/>

        <!-- Expected Count -->
        <TextBlock Grid.Row="7" Grid.Column="0" Text="Expected Count:" Margin="0,0,0,4" VerticalAlignment="Center"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="ExpectedCountBox" Margin="0,0,0,10" FontSize="11" AutomationProperties.AutomationId="StepExpectedCountBox"/>

        <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" x:Name="NonStandardCheck" Content="Non-standard element (no AutomationId)" Margin="0,0,0,10" FontSize="11"
                  AutomationProperties.AutomationId="StepNonStandardCheck"/>

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnStepCancel" Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click" AutomationProperties.AutomationId="StepCancelButton"/>
            <Button x:Name="btnStepOk" Content="OK" Width="80" Click="Ok_Click" IsDefault="True" AutomationProperties.AutomationId="StepOkButton"/>
        </StackPanel>
    </Grid>
</Window>
