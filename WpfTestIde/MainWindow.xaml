<Window x:Class="WpfTestIde.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WpfTestIde.Models"
        xmlns:views="clr-namespace:WpfTestIde.Views"
        Title="WPF Test IDE" Height="760" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- One recorded/verify step row -->
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type models:RecordedStep}">
            <Border Padding="8" Margin="0,0,0,4" CornerRadius="3"
                    Background="{Binding Kind, Converter={StaticResource StepKindToBrushConverter}}"
                    BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontFamily="Consolas" FontSize="12">
                            <Run Text="{Binding DisplayVerb, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="  "/>
                            <Run Text="{Binding Alias, Mode=OneWay}" Foreground="#2563EB"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="Gray"
                                   Text="{Binding Value, StringFormat='value: {0}'}"
                                   Visibility="{Binding Value, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <TextBlock FontSize="10" Foreground="#B8860B" Text="Warning: custom control - resolved via WPFSpy"
                                   Visibility="{Binding NonStandard, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ verify after"
                            Command="{Binding DataContext.AddVerificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            FontSize="10" Padding="4,2" Margin="4,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="X"
                            Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            FontSize="10" Padding="4,2" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ================= Toolbar ================= -->
        <Border DockPanel.Dock="Top" Background="#1B2029" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButton}" Content="Attach to Process..." Command="{Binding AttachCommand}"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Check Pipe" Command="{Binding CheckPipeConnectionCommand}"/>
                <Button Style="{StaticResource ToolbarButton}" Content="{Binding RecordButtonLabel}" Command="{Binding ToggleRecordingCommand}"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Load Sample" Command="{Binding LoadSampleCommand}"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Reset" Command="{Binding ResetCommand}"/>
                <Separator Margin="8,0"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Run Script" Command="{Binding RunCommand}" Background="#E8A33D"/>
                <Separator Margin="8,0"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Export Repository (.yaml)" Command="{Binding ExportRepositoryCommand}"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Export Script (.robot)" Command="{Binding ExportScriptCommand}"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Save Script" Command="{Binding SaveScriptCommand}"/>
                <Separator Margin="8,0"/>
                <Button Style="{StaticResource ToolbarButton}" Content="OCR DataGrid" Command="{Binding GetDataGridContentOcrCommand}"/>
                <Separator Margin="8,0"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Checkpoint Wizard" Command="{Binding OpenCheckpointWizardCommand}"/>
                <Separator Margin="8,0"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Spy Tool" Command="{Binding OpenSpyToolCommand}"/>
                <Separator Margin="8,0"/>
                <Button Style="{StaticResource ToolbarButton}" Content="Visual Test Builder" Command="{Binding OpenVisualTestBuilderCommand}" Background="#7B1FA2"/>
            </StackPanel>
        </Border>

        <!-- ================= Status bar ================= -->
        <Border DockPanel.Dock="Top" Background="#F4F5F7" Padding="8,4" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#444"/>
                <TextBlock Text="{Binding PipeStatusText}" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- ================= OCR Result ================= -->
        <Border DockPanel.Dock="Bottom" Background="#1E2A3A" Padding="8" BorderBrush="#333" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="OCR Result" FontSize="11" Foreground="#666" Margin="0,0,0,4"/>
                <TextBox Text="{Binding OcrResultText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True"
                         Background="#0D1117" Foreground="#C9D1D9" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         MaxHeight="120"/>
            </DockPanel>
        </Border>

        <!-- ================= Main split ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <!-- Recorded steps -->
            <DockPanel Grid.Column="0" Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="Recorded Steps" FontWeight="Bold" Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>

            <!-- Tabs: combined element / script / run -->
            <TabControl Grid.Column="1" Margin="10">
                <!-- Combined Element tab: raw JSON + tree + properties in one view -->
                <TabItem Header="Elements">
                    <DockPanel Margin="6">
                        <!-- Raw JSON -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,6" Padding="6" Background="#12161C" CornerRadius="3">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Raw JSON" FontSize="11" FontWeight="Bold" Foreground="#6A737D" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding RepositoryYaml, Mode=OneWay}" FontFamily="Consolas" FontSize="11"
                                         IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="Transparent" Foreground="#C9D1D9" BorderThickness="0"
                                         MaxHeight="60"/>
                            </DockPanel>
                        </Border>

                        <!-- Tree + Properties side by side -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Element Tree -->
                            <Border Grid.Column="0" Margin="0,0,6,0" Padding="6" Background="#F8F9FA" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="3">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🌳" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Element Tree" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="+" ToolTip="Add Element" Padding="6,2" FontSize="12"
                                                        Command="{Binding ElementTree.AddElementCommand}" Background="#28A745" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                                <Button Content="👁 Preview" ToolTip="Preview Element" Padding="6,2" FontSize="11" Margin="4,0,0,0"
                                                        Command="{Binding PreviewElementCommand}" Background="#E8A33D" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                                <Button Content="🔍 Pick" ToolTip="Pick Element" Padding="6,2" FontSize="11" Margin="4,0,0,0"
                                                        Command="{Binding PickElementCommand}" Background="#0366D6" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <views:ElementTreeView DataContext="{Binding ElementTree}"/>
                                </DockPanel>
                            </Border>

                            <!-- Properties -->
                            <Border Grid.Column="1" Padding="6" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
                                <views:ElementEditorView/>
                            </Border>
                        </Grid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Generated Script">
                    <DockPanel Margin="6">
                        <TextBlock DockPanel.Dock="Top" Text="Raw Layer 3 calls - review/refactor before committing to the suite."
                                   FontSize="11" Foreground="Gray" Margin="0,0,0,6"/>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="Run Driver:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                            <ComboBox DockPanel.Dock="Left" SelectedItem="{Binding SelectedDriver}"
                                      ItemsSource="{Binding AvailableDrivers}" Width="100" FontSize="11"/>
                            <TextBlock DockPanel.Dock="Left" Text="  Mode:" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11"/>
                            <ComboBox DockPanel.Dock="Left" SelectedItem="{Binding SelectedMode}"
                                      ItemsSource="{Binding AvailableModes}" Width="80" FontSize="11"/>
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="Record:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                            <CheckBox DockPanel.Dock="Left" Content="FlaUI" IsChecked="{Binding RecordFlaUI}" Margin="0,0,8,0" FontSize="11"/>
                            <CheckBox DockPanel.Dock="Left" Content="WPFSpy" IsChecked="{Binding RecordWPFSpy}" Margin="0,0,8,0" FontSize="11"/>
                            <CheckBox DockPanel.Dock="Left" Content="Sikuli" IsChecked="{Binding RecordSikuli}" FontSize="11"/>
                        </DockPanel>
                        <TextBox Text="{Binding GeneratedScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12"
                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="#12161C" Foreground="#C9D1D9" BorderThickness="0"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Run Results">
                    <DockPanel Margin="6">
                        <Border DockPanel.Dock="Top" Padding="8" Margin="0,0,0,8" CornerRadius="3"
                                Background="{Binding LastRunSuccess, Converter={StaticResource BoolToStatusBrushConverter}}">
                            <TextBlock Text="{Binding RunSummaryText}" FontFamily="Consolas" FontWeight="Bold"/>
                        </Border>
                         <TextBox Text="{Binding RunOutputText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5"
                                 Background="#12161C" Foreground="#C9D1D9" BorderThickness="0"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 VerticalScrollBarVisibility="Auto"
                                 TextOptions.TextFormattingMode="Display"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Margin="0,0,0,4"/>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
