<Window x:Class="WpfTestIde.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WpfTestIde.Models"
        xmlns:views="clr-namespace:WpfTestIde.Views"
        Title="WPF Test IDE" Height="760" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        AutomationProperties.AutomationId="MainWindow">

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource VsButton}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TabItem" BasedOn="{StaticResource VsTabItem}">
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- B2: thin label shown above each toolbar band (Session/Record/Run/Export/Tools) -->
        <Style x:Key="ToolbarBandLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- B2: vertical container for one band = a small label + a horizontal row of buttons -->
        <Style x:Key="ToolbarBand" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- A7: per-tab toolbar Border (sits at the top of each TabItem content).
             Themed identically to the global toolbar for visual consistency. -->
        <Style x:Key="TabToolbarBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <!-- One recorded/verify step row -->
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type models:RecordedStep}">
            <Border Padding="8" Margin="0,0,0,4" CornerRadius="3"
                    Background="{Binding Kind, Converter={StaticResource StepKindToBrushConverter}}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontFamily="Consolas" FontSize="12">
                            <Run Text="{Binding DisplayVerb, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="  "/>
                            <Run Text="{Binding Alias, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding Value, StringFormat='value: {0}'}"
                                   Visibility="{Binding Value, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <TextBlock FontSize="10" Foreground="{DynamicResource WarningBrush}" Text="Warning: custom control - resolved via WPFSpy"
                                   Visibility="{Binding NonStandard, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ verify after"
                            Command="{Binding DataContext.AddVerificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            FontSize="10" Padding="4,2" Margin="4,0" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="btnAddVerification"/>
                    <Button Grid.Column="2" Content="X"
                            Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            FontSize="10" Padding="4,2" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- E2: global keyboard shortcuts. Bound to the same VM commands as the menu/toolbar.
         Gestures also surfaced via InputGestureText on the MenuItem templates' reserved column. -->
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveScriptCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RunCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding ToggleRecordingCommand}"/>
        <KeyBinding Key="F12" Command="{Binding OpenSpyToolCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- ================= Menu Bar ================= -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource ToolbarBrush}" Height="26">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Script..." Command="{Binding OpenScriptCommand}"/>
                <MenuItem Header="_Save Script" Command="{Binding SaveScriptCommand}" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}"/>
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}"/>
                <Separator/>
                <MenuItem Header="Cu_t"/>
                <MenuItem Header="_Copy"/>
                <MenuItem Header="_Paste"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Toggle Theme" Command="{Binding ToggleThemeCommand}"/>
                <Separator/>
                <MenuItem Header="E_lements" Command="{Binding ShowElementsCommand}"/>
                <MenuItem Header="_Scripts" Command="{Binding ShowScriptsCommand}"/>
                <MenuItem Header="_Results" Command="{Binding ShowResultsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Run Script" Command="{Binding RunCommand}" InputGestureText="Ctrl+R / F5"/>
                <MenuItem Header="Record _Toggle" Command="{Binding ToggleRecordingCommand}" InputGestureText="Ctrl+Shift+R"/>
                <MenuItem Header="_Stop Recording" Command="{Binding StopRecordingCommand}"/>
                <Separator/>
                <MenuItem Header="Spy _Tool" Command="{Binding OpenSpyToolCommand}" InputGestureText="F12"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
                <MenuItem Header="_Documentation" Command="{Binding DocumentationCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ================= Left Activity Bar ================= -->
        <Border DockPanel.Dock="Left" Width="48" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel>
                <Button Content="📁" ToolTip="Elements" Background="Transparent" BorderThickness="0" Padding="10,8" Click="ActivityElements_Click"/>
                <Button Content="📜" ToolTip="Scripts" Background="Transparent" BorderThickness="0" Padding="10,8" Click="ActivityScripts_Click"/>
                <Button Content="▶️" ToolTip="Run" Background="Transparent" BorderThickness="0" Padding="10,8" Click="ActivityRun_Click"/>
                <Button Content="🔎" ToolTip="Spy Tool" Background="Transparent" BorderThickness="0" Padding="10,8" Click="ActivitySpy_Click"/>
                <Button Content="🧩" ToolTip="Visual Builder" Background="Transparent" BorderThickness="0" Padding="10,8" Click="ActivityBuilder_Click"/>
                <Separator Margin="8,4" Background="{DynamicResource BorderBrush}"/>
                <Button Content="⚙️" ToolTip="Settings" Background="Transparent" BorderThickness="0" Padding="10,8" Click="ActivitySettings_Click"/>
            </StackPanel>
        </Border>

        <!-- ================= Toolbar =================
             B1: wrap the toolbar in a horizontal ScrollViewer so that when the
             window narrows the buttons scroll instead of being silently clipped
             (a StackPanel inside a Border just clips the right-hand buttons at
             small widths). All AutomationIds/commands are preserved; the scroll
             bar appears only when the content overflows. Vertical scrolling is
             disabled to keep the toolbar a single-row strip. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBrush}" Padding="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0">
                <!-- B2: each toolbar band is a vertical StackPanel (label + horizontal button row),
                     grouping the existing buttons with a small header for scannability.
                     AutomationIds, commands, and order are unchanged. Inter-Tools Separators
                     are preserved within the Tools band. -->
                <StackPanel Orientation="Horizontal">

                    <!-- Session -->
                    <StackPanel Style="{StaticResource ToolbarBand}">
                        <TextBlock Style="{StaticResource ToolbarBandLabel}" Text="Session"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnAttach" Style="{StaticResource ToolbarButton}" Content="Attach to Process..." Command="{Binding AttachCommand}" AutomationProperties.AutomationId="btnAttach"/>
                            <Button x:Name="btnManageApps" Style="{StaticResource ToolbarButton}" Content="Manage Apps" Command="{Binding OpenMultiAppDialogCommand}" ToolTip="Manage attached applications" AutomationProperties.AutomationId="btnManageApps"/>
                            <Button x:Name="btnCheckPipe" Style="{StaticResource ToolbarButton}" Content="Check Pipe" Command="{Binding CheckPipeConnectionCommand}" AutomationProperties.AutomationId="btnCheckPipe"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Record -->
                    <StackPanel Style="{StaticResource ToolbarBand}">
                        <TextBlock Style="{StaticResource ToolbarBandLabel}" Text="Record"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnRecord" Style="{StaticResource ToolbarButton}" Content="{Binding RecordButtonLabel}" Command="{Binding ToggleRecordingCommand}" AutomationProperties.AutomationId="btnRecord"/>
                            <Button x:Name="btnLoadSample" Style="{StaticResource ToolbarButton}" Content="Load Sample" Command="{Binding LoadSampleCommand}" AutomationProperties.AutomationId="btnLoadSample"/>
                            <Button x:Name="btnReset" Style="{StaticResource ToolbarButton}" Content="Reset" Command="{Binding ResetCommand}" AutomationProperties.AutomationId="btnReset"/>
                            <Separator Margin="8,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- A7: Run + Export bands moved to the SCRIPTS per-tab toolbar
                         (RunScript/Export Repo/Export Script/Save Script). Global
                         toolbar now keeps only Session / Record / Tools per the
                         user's A7 decision. AutomationIds on the moved buttons
                         are preserved - they merely relocated. -->

                    <!-- Tools -->
                    <StackPanel Style="{StaticResource ToolbarBand}">
                        <TextBlock Style="{StaticResource ToolbarBandLabel}" Text="Tools"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnOcrDataGrid" Style="{StaticResource ToolbarButton}" Content="OCR DataGrid" Command="{Binding GetDataGridContentOcrCommand}" AutomationProperties.AutomationId="btnOcrDataGrid"/>
                            <Separator Margin="8,0"/>
                            <Button x:Name="btnCheckpointWizard" Style="{StaticResource ToolbarButton}" Content="Checkpoint Wizard" Command="{Binding OpenCheckpointWizardCommand}" AutomationProperties.AutomationId="btnCheckpointWizard"/>
                            <Separator Margin="8,0"/>
                            <Button x:Name="btnSpyTool" Style="{StaticResource ToolbarButton}" Content="Spy Tool" Command="{Binding OpenSpyToolCommand}" AutomationProperties.AutomationId="btnSpyTool"/>
                            <Separator Margin="8,0"/>
                            <Button x:Name="btnVisualTestBuilder" Style="{StaticResource ToolbarButton}" Content="Visual Test Builder" Command="{Binding OpenVisualTestBuilderCommand}" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource StatusBarTextBrush}" AutomationProperties.AutomationId="btnVisualTestBuilder"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= Status bar (C1+C2: real StatusBar with slots) =================
             Previously two stacked horizontal strips: a custom Border+StackPanel
             for status text, and a separate Driver Settings Border with the
             Record/Run checkboxes. Consolidated into one StatusBar:
               left  : StatusText + PipeStatus
               right : Record:* and Run:* driver checkboxes (preserved AutomationIds)
             The AutomationIds chkRecordFlaUI / chkRecordWPFSpy / chkRecordSikuli
             and chkRunFlaUI / chkRunWPFSpy / chkRunSikuli remain on CheckBoxes
             under MainWindow so repository locators and Robot tests still find
             them. StatusText / PipeStatusText AutomationIds also preserved. -->
        <StatusBar DockPanel.Dock="Top"
                    Background="{DynamicResource PanelBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="8,2"
                    AutomationProperties.AutomationId="MainStatusBar">
            <StatusBarItem HorizontalAlignment="Left" Padding="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="StatusText"/>
                    <TextBlock Text="  |  " Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PipeStatusText" Text="{Binding PipeStatusText}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="PipeStatusText"/>
                </StackPanel>
            </StatusBarItem>

            <!-- right-aligned driver settings slot -->
            <StatusBarItem HorizontalAlignment="Right" Padding="8,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Record driver checkboxes -->
                    <TextBlock Text="Record:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <CheckBox x:Name="chkRecordFlaUI" Content="FlaUI" IsChecked="{Binding RecordFlaUI}" Margin="0,0,6,0" FontSize="11" VerticalContentAlignment="Center" AutomationProperties.AutomationId="chkRecordFlaUI"/>
                    <CheckBox x:Name="chkRecordWPFSpy" Content="WPFSpy" IsChecked="{Binding RecordWPFSpy}" Margin="0,0,6,0" FontSize="11" VerticalContentAlignment="Center" AutomationProperties.AutomationId="chkRecordWPFSpy"/>
                    <CheckBox x:Name="chkRecordSikuli" Content="Sikuli" IsChecked="{Binding RecordSikuli}" Margin="0,0,12,0" FontSize="11" VerticalContentAlignment="Center" AutomationProperties.AutomationId="chkRecordSikuli"/>
                    <!-- Run driver checkboxes -->
                    <TextBlock Text="Run:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <CheckBox x:Name="chkRunFlaUI" Content="FlaUI" IsChecked="{Binding RunFlaUI}" Margin="0,0,6,0" FontSize="11" VerticalContentAlignment="Center" AutomationProperties.AutomationId="chkRunFlaUI"/>
                    <CheckBox x:Name="chkRunWPFSpy" Content="WPFSpy" IsChecked="{Binding RunWPFSpy}" Margin="0,0,6,0" FontSize="11" VerticalContentAlignment="Center" AutomationProperties.AutomationId="chkRunWPFSpy"/>
                    <CheckBox x:Name="chkRunSikuli" Content="Sikuli" IsChecked="{Binding RunSikuli}" FontSize="11" VerticalContentAlignment="Center" AutomationProperties.AutomationId="chkRunSikuli"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ================= OCR Result (collapsible bottom panel) =================
             A3: previously a permanently-docked strip consuming ~120px even when
             no OCR was running. Now an Expander collapsed by default; expands
             automatically (via OcrPanelExpanded) when fresh OCR text arrives, and
             the user can collapse it again. Frees the vertical space otherwise. -->
        <Expander DockPanel.Dock="Bottom"
                  IsExpanded="{Binding OcrPanelExpanded, Mode=TwoWay}"
                  Padding="8,4"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,1,0,0"
                  AutomationProperties.AutomationId="OcrResultExpander">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="OCR Result" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <!-- "(empty)" badge when no OCR text has been produced yet -->
                     <TextBlock Text="(empty)" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                Visibility="{Binding OcrResultText, Converter={StaticResource EmptyStringToVisibleConverter}, Mode=OneWay}"/>
                </StackPanel>
            </Expander.Header>
            <TextBox x:Name="txtOcrResult" Text="{Binding OcrResultText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True"
                     Style="{StaticResource VsCodeEditor}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     MaxHeight="120" AutomationProperties.AutomationId="txtOcrResult"/>
        </Expander>

        <!-- ================= Main Tabs ================= -->
        <TabControl x:Name="MainTabControl" Margin="10" AutomationProperties.AutomationId="MainTabControl">
            <!-- ELEMENTS Tab -->
            <TabItem x:Name="tabElements" Header="ELEMENTS" AutomationProperties.AutomationId="tabElements">
                <DockPanel Margin="6">
                    <!-- Toolbar -->
                    <Border DockPanel.Dock="Top" Margin="0,6,0,6" Padding="4" Background="{DynamicResource PanelBrush}" CornerRadius="3">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnAddFolder" Content="+ Folder" ToolTip="Add Folder" Padding="6,2" FontSize="11"
                                    Command="{Binding ElementTree.AddFolderCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource StatusBarTextBrush}" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="btnAddFolder"/>
                            <Button x:Name="btnAddElement" Content="+ Element" ToolTip="Add Element to selected folder" Padding="6,2" FontSize="11" Margin="4,0,0,0"
                                    Command="{Binding ElementTree.AddElementCommand}" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource StatusBarTextBrush}" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="btnAddElement"/>
                            <Button x:Name="btnPickElement" Content="🔍 Pick" ToolTip="Pick Element from target app" Padding="6,2" FontSize="11" Margin="4,0,0,0"
                                    Command="{Binding PickElementCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource StatusBarTextBrush}" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="btnPickElement"/>
                            <Button x:Name="btnPreviewElement" Content="👁 Preview" ToolTip="Preview selected element" Padding="6,2" FontSize="11" Margin="4,0,0,0"
                                    Command="{Binding PreviewElementCommand}" Background="{DynamicResource WarningBrush}" Foreground="{DynamicResource StatusBarTextBrush}" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="btnPreviewElement"/>
                            <Separator Margin="8,0,4,0" VerticalAlignment="Center"/>
                            <Button x:Name="btnExpandAll" Content="⬇️ Expand All" ToolTip="Expand All" Padding="6,2" FontSize="11"
                                    Command="{Binding ElementTree.ExpandAllCommand}" Background="{DynamicResource ButtonBackgroundBrush}" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="btnExpandAll"/>
                            <Button x:Name="btnCollapseAll" Content="⬆️ Collapse" ToolTip="Collapse All" Padding="6,2" FontSize="11" Margin="4,0,0,0"
                                    Command="{Binding ElementTree.CollapseAllCommand}" Background="{DynamicResource ButtonBackgroundBrush}" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="btnCollapseAll"/>
                        </StackPanel>
                    </Border>

                    <!-- ================= Raw JSON / Repository (A4: collapsible bottom panel) =================
                         Previously an inner TabControl+TabItem locked at Height=200 inside the
                         ELEMENTS tab. Now a bottom-docked Expander collapsed by default so the
                         tree+properties above get all the vertical space. The user expands to
                         inspect the live-generated YAML. AutomationId tabRawJson is preserved
                         (now on the Expander, see repository/elements/wpf_test_ide.yaml which
                         has been updated to controlType=Expander + Expander XPath); the YAML
                         TextBox AutomationId txtRepositoryYaml is unchanged. -->
                    <Expander DockPanel.Dock="Bottom"
                              IsExpanded="{Binding RepositoryPanelExpanded, Mode=TwoWay}"
                              Padding="8,4"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="0,1,0,0"
                              AutomationProperties.AutomationId="tabRawJson">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Repository (YAML)" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="read-only - regenerates live as elements are added" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Expander.Header>
                        <TextBox x:Name="txtRepositoryYaml" Text="{Binding RepositoryYaml, Mode=OneWay}" FontFamily="Consolas" FontSize="11"
                                 IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Style="{StaticResource VsCodeEditor}"
                                 MinHeight="120" MaxHeight="280"
                                 AutomationProperties.AutomationId="txtRepositoryYaml"/>
                    </Expander>

                    <!-- Tree + Properties side by side (resizable) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Element Tree -->
                        <Border Grid.Column="0" Margin="0,0,6,0" Padding="6" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <views:ElementTreeView DataContext="{Binding ElementTree}"/>
                        </Border>

                        <!-- Resizer between the Element Tree and the Properties pane -->
                        <GridSplitter Grid.Column="1"
                                      Width="5"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch"
                                      Background="{DynamicResource AccentBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,0"
                                      Cursor="SizeWE"
                                      ResizeBehavior="PreviousAndNext"
                                      ShowsPreview="False"/>

                        <!-- Properties -->
                        <Border Grid.Column="2" Padding="6" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                            <views:ElementEditorView/>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- SCRIPTS Tab -->
            <TabItem x:Name="tabScripts" Header="SCRIPTS" AutomationProperties.AutomationId="tabScripts">
                <DockPanel Margin="6">
                    <!-- A7: per-tab toolbar for SCRIPTS. Hosts the Run + Export buttons
                         that previously lived in the global toolbar (kept AutomationIds:
                         btnRunScript / btnExportRepo / btnExportScript / btnSaveScript).
                         Record/Run duplicate driver checkboxes that used to live inside
                         the inner Raw sub-tab have been removed (they already live once,
                         canonically, in the StatusBar - see chkRecordFlaUI etc.). -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource TabToolbarBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnRunScript" Style="{StaticResource ToolbarButton}" Content="Run Script" ToolTip="Run the current script (F5)"
                                    Command="{Binding RunCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource StatusBarTextBrush}" AutomationProperties.AutomationId="btnRunScript"/>
                            <Separator Margin="8,0,4,0" VerticalAlignment="Center"/>
                            <Button x:Name="btnSaveScript" Style="{StaticResource ToolbarButton}" Content="Save Script" ToolTip="Save the generated script (Ctrl+S)"
                                    Command="{Binding SaveScriptCommand}" AutomationProperties.AutomationId="btnSaveScript"/>
                            <Button x:Name="btnExportRepo" Style="{StaticResource ToolbarButton}" Content="Export Repository (.yaml)" Command="{Binding ExportRepositoryCommand}" AutomationProperties.AutomationId="btnExportRepo"/>
                            <Button x:Name="btnExportScript" Style="{StaticResource ToolbarButton}" Content="Export Script (.robot)" Command="{Binding ExportScriptCommand}" AutomationProperties.AutomationId="btnExportScript"/>
                        </StackPanel>
                    </Border>

                    <TabControl>
                        <!-- Visual: Recorded Steps -->
                        <TabItem x:Name="tabVisualSteps" Header="Visual" AutomationProperties.AutomationId="tabVisualSteps">
                            <ListBox x:Name="StepsListBox" ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Margin="0,6,0,0" AutomationProperties.AutomationId="StepsListBox"/>
                        </TabItem>
                        <!-- Raw: Generated Script -->
                        <TabItem x:Name="tabRawScript" Header="Raw" AutomationProperties.AutomationId="tabRawScript">
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Top" Text="Raw Layer 3 calls - review/refactor before committing to the suite."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="Run Driver:" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox x:Name="cmbRunDriver" DockPanel.Dock="Left" SelectedItem="{Binding SelectedDriver}"
                                              ItemsSource="{Binding AvailableDrivers}" Width="100" FontSize="11" AutomationProperties.AutomationId="cmbRunDriver"/>
                                    <TextBlock DockPanel.Dock="Left" Text="  Mode:" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ComboBox x:Name="cmbRunMode" DockPanel.Dock="Left" SelectedItem="{Binding SelectedMode}"
                                              ItemsSource="{Binding AvailableModes}" Width="80" FontSize="11" AutomationProperties.AutomationId="cmbRunMode"/>
                                </DockPanel>
                                <!-- A7: the duplicate Record/Run driver checkboxes that
                                     lived here (chkScriptRecordFlaUI / chkScriptRun*
                                     etc.) have been removed - they duplicated the
                                     canonical StatusBar ones (chkRecordFlaUI / chkRun*
                                     in the status bar) and were unused by tests. -->
                                <TextBox x:Name="txtGeneratedScript" Text="{Binding GeneratedScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12"
                                         TextWrapping="NoWrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Style="{StaticResource VsCodeEditor}" AutomationProperties.AutomationId="txtGeneratedScript"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </TabItem>

            <!-- RESULTS Tab -->
            <TabItem x:Name="tabResults" Header="RESULTS" AutomationProperties.AutomationId="tabResults">
                <DockPanel Margin="6">
                    <!-- A7: per-tab toolbar for RESULTS. Re-runs / re-exports without
                         switching tabs. RESULTS deliberately uses DISTINCT AutomationIds
                         (btnResultsRerun / btnResultsExportScript / btnResultsReset) -
                         not the SCRIPTS-tab IDs (btnRunScript / btnExportScript /
                         btnSaveScript). Cross-tab AutomationId reuse would be unsafe:
                         WPF TabControls (no virtualization here) keep every TabItem's
                         content in the visual tree, so a reused AutomationId would
                         resolve ambiguously when repository/elements/wpf_test_ide.yaml
                         searches by relativeXPath="Button[@AutomationId='...']".
                         The commands themselves (RunCommand / ExportScriptCommand /
                         ResetCommand) are intentionally bound to multiple buttons -
                         that's safe because the AutomationIds, not the commands, are
                         the locators. -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource TabToolbarBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnResultsRerun" Style="{StaticResource ToolbarButton}" Content="Run Again" ToolTip="Re-run the current script (F5)"
                                    Command="{Binding RunCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource StatusBarTextBrush}" AutomationProperties.AutomationId="btnResultsRerun"/>
                            <Separator Margin="8,0,4,0" VerticalAlignment="Center"/>
                            <Button x:Name="btnResultsExportScript" Style="{StaticResource ToolbarButton}" Content="Export Script (.robot)"
                                    Command="{Binding ExportScriptCommand}" AutomationProperties.AutomationId="btnResultsExportScript"/>
                            <Button x:Name="btnResultsReset" Style="{StaticResource ToolbarButton}" Content="Reset" ToolTip="Reload a fresh sample"
                                    Command="{Binding ResetCommand}" AutomationProperties.AutomationId="btnResultsReset"/>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="8" Margin="0,6,0,6" CornerRadius="3"
                            Background="{Binding LastRunSuccess, Converter={StaticResource BoolToStatusBrushConverter}}">
                        <TextBlock x:Name="txtRunSummary" Text="{Binding RunSummaryText}" FontFamily="Consolas" FontWeight="Bold" AutomationProperties.AutomationId="txtRunSummary"/>
                    </Border>
                    <TextBox x:Name="txtRunOutput" Text="{Binding RunOutputText, Mode=OneWay}" FontFamily="Consolas" FontSize="11.5"
                             Style="{StaticResource VsCodeEditor}"
                             IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             VerticalScrollBarVisibility="Auto"
                             TextOptions.TextFormattingMode="Display"
                             AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.AutomationId="txtRunOutput"/>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
