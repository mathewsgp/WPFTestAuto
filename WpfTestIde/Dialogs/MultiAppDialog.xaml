<Window x:Class="WpfTestIde.Dialogs.MultiAppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Applications" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Attached Applications" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

        <DataGrid Grid.Row="1" x:Name="AppsGrid" AutoGenerateColumns="False" 
                  CanUserAddRows="False" Margin="0,0,0,12" IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault}" IsReadOnly="True"/>
                <DataGridTextColumn Header="App ID" Binding="{Binding AppId}" Width="120"/>
                <DataGridTextColumn Header="App Name" Binding="{Binding AppName}" Width="*"/>
                <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="80"/>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"/>
                <DataGridTextColumn Header="Pipe" Binding="{Binding PipeName}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Content="Set as Default" Width="100" Margin="0,0,8,0" Click="SetDefault_Click"/>
            <Button Grid.Column="2" Content="Detach" Width="80" Margin="0,0,8,0" Click="Detach_Click" Background="#FFE0E0"/>
            <Button Grid.Column="3" Content="Close" Width="80" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
