<Window x:Class="WpfTestIde.Dialogs.AddVerificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Verification" Height="220" Width="440"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Element:" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="1" x:Name="AliasCombo" Margin="0,0,0,10" SelectionChanged="AliasCombo_SelectionChanged"/>

        <TextBlock Grid.Row="2" Text="Expected text:" Margin="0,0,0,4"/>
        <TextBox Grid.Row="3" x:Name="ExpectedBox" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" x:Name="HintText" Foreground="Gray" TextWrapping="Wrap" FontSize="11"
                   Text="Tip: pick the element and adjust the expected text — this becomes a Verify Element Text step."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Add" Width="80" Click="Add_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
