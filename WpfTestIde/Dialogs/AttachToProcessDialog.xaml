<Window x:Class="WpfTestIde.Dialogs.AttachToProcessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attach to Process" Height="600" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Mode Selection -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="RuntimeAttachRadio" Content="Runtime Attach (Already Running)" 
                        IsChecked="True" Margin="0,0,20,0" VerticalContentAlignment="Center"
                        Checked="RuntimeAttachRadio_Checked"/>
            <RadioButton x:Name="NewProcessRadio" Content="Launch New Process"
                        Margin="0,0,20,0" VerticalContentAlignment="Center"
                        Checked="NewProcessRadio_Checked"/>
        </StackPanel>

        <!-- Process List (Runtime Attach Mode) -->
        <Grid Grid.Row="1" x:Name="RuntimeAttachPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Select the target application's process:" 
                      Style="{StaticResource SectionHeader}"/>

            <ListView Grid.Row="1" x:Name="ProcessListView" Margin="0,0,0,8">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="PID" Width="60" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="Window Title" Width="280" DisplayMemberBinding="{Binding MainWindowTitle}"/>
                        <GridViewColumn Header="Process Name" Width="130" DisplayMemberBinding="{Binding ProcessName}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Content="Refresh List" Click="RefreshProcessList_Click" 
                       Width="100" Margin="0,0,8,0"/>
                <CheckBox x:Name="ShowAllProcessesCheck" Content="Show all processes" 
                         VerticalAlignment="Center" Margin="8,0,0,0"
                         Checked="ShowAllProcessesCheck_Changed"
                         Unchecked="ShowAllProcessesCheck_Changed"/>
            </StackPanel>
        </Grid>

        <!-- New Process Panel (hidden by default) -->
        <Grid Grid.Row="1" x:Name="NewProcessPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Application to launch:" Style="{StaticResource SectionHeader}"/>
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="ApplicationPathBox" 
                        Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Browse..." 
                       Width="80" Click="BrowseApplication_Click"/>
            </Grid>

            <TextBlock Grid.Row="2" Text="Arguments (optional):" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
            <TextBox Grid.Row="3" x:Name="ArgumentsBox" Margin="0,0,0,8"/>

            <Border Grid.Row="4" Background="#E8F4FD" Padding="10" CornerRadius="4" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Environment Variables for Spy Agent Injection:" 
                              FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock FontFamily="Consolas" FontSize="11">
                        <Run Text="DOTNET_STARTUP_HOOKS="/>
                        <Run Text="C:\path\to\WpfSpyAgent.StartupHook.dll" Foreground="#0066CC"/>
                    </TextBlock>
                    <TextBlock FontFamily="Consolas" FontSize="11">
                        <Run Text="WPFSPY_AGENT_ENABLED="/>
                        <Run Text="1" Foreground="#0066CC"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pipe Name -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Spy Agent Named Pipe name:" Margin="0,0,0,4"/>
            <TextBox x:Name="PipeNameBox" Text="WPFSpyAgentPipe"/>
        </StackPanel>

        <!-- Page Mapping -->
        <GroupBox Grid.Row="4" Header="Page name mapping (window title contains → page alias)" Margin="0,10,0,0">
            <DataGrid x:Name="PageMapGrid" AutoGenerateColumns="False" 
                     CanUserAddRows="True" Margin="4"
                     MinHeight="80">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title contains" Binding="{Binding TitleContains}" Width="*"/>
                    <DataGridTextColumn Header="Page alias" Binding="{Binding PageAlias}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Status and Buttons -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="StatusText" 
                      Style="{StaticResource StatusText}"
                      VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Cancel" Width="80" Margin="0,0,8,0" 
                       Click="Cancel_Click" IsCancel="True"/>
                <Button Content="Attach" Width="100" Click="Attach_Click" 
                       IsDefault="True" Background="#E8F4FD"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
