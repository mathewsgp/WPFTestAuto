<Window x:Class="WpfTestIde.Dialogs.SikuliSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sikuli Settings" Height="320" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Border Margin="10" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
        <StackPanel>
            <TextBlock Text="Sikuli Driver Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock Text="Default similarity threshold (0.50 – 0.99)" FontSize="12" Margin="0,0,0,2"/>
            <DockPanel Margin="0,0,0,10">
                <Slider x:Name="sldSimilarity" Minimum="0.5" Maximum="0.99" Value="0.85" TickFrequency="0.01" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Width="280" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Value, ElementName=sldSimilarity, StringFormat={}{0:F2}}" Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"/>
            </DockPanel>

            <TextBlock Text="Capture padding (px) — whitespace margin around the template" FontSize="12" Margin="0,0,0,2"/>
            <DockPanel Margin="0,0,0,10">
                <Slider x:Name="sldPadding" Minimum="0" Maximum="20" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Width="280" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Value, ElementName=sldPadding, StringFormat={}{0:F0} px}" Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12"/>
            </DockPanel>

            <TextBlock Text="Matcher backend" FontSize="12" Margin="0,0,0,2"/>
            <ComboBox x:Name="cbMatcher" Width="260" Margin="0,0,0,10" FontSize="12">
                <ComboBoxItem Content="OpenCV (single-scale)" Tag="opencv"/>
                <ComboBoxItem Content="Multi-scale (0.9× / 1.0× / 1.1×)" Tag="multi" IsSelected="True"/>
                <ComboBoxItem Content="Stub (no desktop needed)" Tag="stub"/>
            </ComboBox>

            <TextBlock Text="Screen capture backend" FontSize="12" Margin="0,0,0,2"/>
            <ComboBox x:Name="cbCapture" Width="260" Margin="0,0,0,10" FontSize="12">
                <ComboBoxItem Content="mss (full desktop)" Tag="mss" IsSelected="True"/>
                <ComboBoxItem Content="PrintWindow (per-window, Windows only)" Tag="printwindow"/>
                <ComboBoxItem Content="Stub (1×1 black buffer)" Tag="stub"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="OK" Width="80" Margin="0,0,6,0" Click="OnOk"/>
                <Button Content="Cancel" Width="80" Click="OnCancel"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
