<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- CANONICAL REFERENCE for the dark theme palette.                    -->
    <!-- The runtime dark theme is applied programmatically by ThemeManager -->
    <!-- (Themes/ThemeManager.cs -> DarkColors array), which creates mutable -->
    <!-- (unfrozen) brushes so DynamicResource references update live. This  -->
    <!-- XAML file is NOT merged into App/Resources at runtime so it cannot  -->
    <!-- override those mutable brushes with frozen XAML instances.         -->
    <!-- When you change a value here, update ThemeManager.DarkColors too.   -->
    <!-- ================================================================= -->

    <!-- Dark Theme Colors (VS Code Dark+) -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#252526"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#555555"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#969696"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6D6D6D"/>
    
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0098FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0062A3"/>
    
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F44336"/>
    
    <SolidColorBrush x:Key="ToolbarBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="#FFFFFF"/>
    
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#4E4E4E"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#555555"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#555555"/>
    
    <SolidColorBrush x:Key="TabActiveBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="TabInactiveBrush" Color="#2D2D30"/>
    <SolidColorBrush x:Key="TabBorderBrush" Color="#3E3E42"/>
    
    <SolidColorBrush x:Key="ListBoxItemHoverBrush" Color="#2A2D2E"/>
    <SolidColorBrush x:Key="ListBoxItemSelectedBrush" Color="#094771"/>
    <SolidColorBrush x:Key="ListBoxItemSelectedBorderBrush" Color="#007ACC"/>

</ResourceDictionary>
