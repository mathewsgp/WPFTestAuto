<UserControl x:Class="WpfTestIde.Views.ElementEditorView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:models="clr-namespace:WpfTestIde.Models"
              xmlns:viewmodels="clr-namespace:WpfTestIde.ViewModels"
              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
 
    <DockPanel Margin="6" Background="{DynamicResource BackgroundBrush}">
        <TextBlock DockPanel.Dock="Top" Text="Properties" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Alias" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBox Text="{Binding EditingElement.Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     FontFamily="Consolas" FontSize="12" Padding="4" Margin="0,0,0,8"/>

            <TextBlock Text="DisplayName" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBox Text="{Binding EditingElement.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     FontFamily="Consolas" FontSize="12" Padding="4" Margin="0,0,0,8"/>

            <TextBlock Text="ControlType" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBox Text="{Binding EditingElement.ControlType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     FontFamily="Consolas" FontSize="12" Padding="4" Margin="0,0,0,8"/>

            <TextBlock Text="AutomationId" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBox Text="{Binding EditingElement.AutomationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     FontFamily="Consolas" FontSize="12" Padding="4" Margin="0,0,0,8"/>

            <TextBlock Text="Name" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBox Text="{Binding EditingElement.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     FontFamily="Consolas" FontSize="12" Padding="4" Margin="0,0,0,8"/>

            <TextBlock Text="XPath" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBox Text="{Binding EditingElement.XPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     FontFamily="Consolas" FontSize="12" Padding="4" Margin="0,0,0,8" 
                     AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>

            <TextBlock Text="Driver Priority Order" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
            <DockPanel Margin="0,0,0,8">
                <ListBox x:Name="DriverPriorityListBox" ItemsSource="{Binding EditingElement.DriverPriority}" 
                         Height="80" Width="200" FontSize="11" Margin="0,0,4,0" AutomationProperties.AutomationId="DriverPriorityListBox"/>
                <StackPanel Orientation="Vertical" DockPanel.Dock="Right">
                    <Button x:Name="btnMovePriorityUp" Content="Up" Command="{Binding MoveElementPriorityUpCommand}" Padding="6,2" FontSize="10" Margin="0,0,0,1" AutomationProperties.AutomationId="btnMovePriorityUp"/>
                    <Button x:Name="btnMovePriorityDown" Content="Down" Command="{Binding MoveElementPriorityDownCommand}" Padding="6,2" FontSize="10" AutomationProperties.AutomationId="btnMovePriorityDown"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Text="Reorder drivers for this element. Top = highest priority." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding PreviewText}" FontFamily="Consolas" FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Height="60"/>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="btnSaveElement" Content="Save" Command="{Binding SaveElementCommand}" Padding="12,6" Margin="0,0,6,0" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource StatusBarTextBrush}" FontWeight="Bold" AutomationProperties.AutomationId="btnSaveElement"/>
            <Button x:Name="btnCancelEdit" Content="Cancel" Command="{Binding CancelEditElementCommand}" Padding="12,6" AutomationProperties.AutomationId="btnCancelEdit"/>
        </StackPanel>
    </DockPanel>
</UserControl>