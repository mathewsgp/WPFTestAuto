<UserControl x:Class="WpfTestIde.Views.ElementEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WpfTestIde.Models"
             xmlns:viewmodels="clr-namespace:WpfTestIde.ViewModels"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">

    <DockPanel Margin="6" Background="White">
        <TextBlock DockPanel.Dock="Top" Text="Element Editor" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Element list -->
            <Border Grid.Column="0" Margin="0,0,6,0" Padding="6" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Elements" FontWeight="Bold" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding Elements}" 
                              SelectedItem="{Binding SelectedElement}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              FontFamily="Consolas" FontSize="12"
                              RowHeaderWidth="0"
                              CanUserAddRows="False"
                              DockPanel.Dock="Top"
                              Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom">
                        <Button Content="+ Add" Command="{Binding AddElementCommand}" Padding="8,4" Margin="0,0,6,0"/>
                        <Button Content="Preview" Command="{Binding PreviewElementCommand}" Padding="8,4" Margin="0,0,6,0"/>
                        <Button Content="Pick Element" Command="{Binding PickElementCommand}" Padding="8,4" Margin="0,0,6,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Detail editor -->
            <Border Grid.Column="1" Padding="6" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Properties" FontWeight="Bold" Margin="0,0,0,6"/>

                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Alias" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding EditingElement.Alias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 FontFamily="Consolas" FontSize="12" Padding="4" Margin="0,0,0,8"/>

                        <TextBlock Text="DisplayName" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding EditingElement.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 FontFamily="Consolas" FontSize="12" Padding="4" Margin="0,0,0,8"/>

                        <TextBlock Text="ControlType" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding EditingElement.ControlType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 FontFamily="Consolas" FontSize="12" Padding="4" Margin="0,0,0,8"/>

                        <TextBlock Text="AutomationId" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding EditingElement.AutomationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 FontFamily="Consolas" FontSize="12" Padding="4" Margin="0,0,0,8"/>

                        <TextBlock Text="Name" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding EditingElement.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 FontFamily="Consolas" FontSize="12" Padding="4" Margin="0,0,0,8"/>

                        <TextBlock Text="XPath" FontSize="11" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding EditingElement.XPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 FontFamily="Consolas" FontSize="12" Padding="4" Margin="0,0,0,8" 
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding PreviewText}" FontFamily="Consolas" FontSize="11"
                               Foreground="Gray" Margin="0,10,0,0" TextWrapping="Wrap" Height="60"/>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="Save" Command="{Binding SaveElementCommand}" Padding="12,6" Margin="0,0,6,0" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                        <Button Content="Cancel" Command="{Binding CancelEditElementCommand}" Padding="12,6"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
