<Window x:Class="WpfTestIde.Views.TestFlowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WpfTestIde.ViewModels"
        mc:Ignorable="d"
        Title="Visual Test Builder"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#2196F3"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#64B5F6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5722"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#F44336"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FF9800"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="CardBrush" Color="White"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#757575"/>

        <!-- Step Item Style -->
        <Style x:Key="StepItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button Style -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Visual Test Builder" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Create tests by arranging steps visually" Foreground="#BBDEFB" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📁 Load" Style="{StaticResource ActionButtonStyle}" 
                            Background="#1565C0" Click="LoadSteps_Click"/>
                    <Button Content="💾 Save" Style="{StaticResource ActionButtonStyle}" 
                            Background="#1565C0" Click="SaveTest_Click"/>
                    <Button Content="📋 Generate Code" Style="{StaticResource ActionButtonStyle}" 
                            Background="{StaticResource SuccessBrush}" Click="GenerateCode_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Action Palette -->
            <Border Grid.Column="0" Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Actions" FontWeight="Bold" 
                               FontSize="14" Margin="12,12,12,8" Foreground="{StaticResource TextPrimaryBrush}"/>

                    <!-- Search Filter -->
                    <TextBox Grid.Row="1" x:Name="ActionSearchBox"
                             Margin="12,0,12,12" Padding="8"
                             TextChanged="ActionSearch_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="#F5F5F5" CornerRadius="4" Padding="4">
                                                <Grid>
                                                    <TextBlock Text="🔍 Search actions..." 
                                                               Foreground="#9E9E9E"
                                                               Margin="4,0" VerticalAlignment="Center"
                                                               Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToVisibleConverter}}"/>
                                                    <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Action Categories -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ActionPalette">
                            <!-- Mouse Actions -->
                            <Expander Header="🖱️ Mouse" IsExpanded="True" Margin="8,4">
                                <StackPanel>
                                    <Button Content="🖱️ Click" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#42A5F5" Click="AddAction_Click" Tag="Click"/>
                                    <Button Content="🖱️🖱️ Double Click" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#42A5F5" Click="AddAction_Click" Tag="DoubleClick"/>
                                    <Button Content="🖱️☑️ Right Click" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#42A5F5" Click="AddAction_Click" Tag="RightClick"/>
                                    <Button Content="👆 Hover" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#42A5F5" Click="AddAction_Click" Tag="Hover"/>
                                </StackPanel>
                            </Expander>

                            <!-- Input Actions -->
                            <Expander Header="⌨️ Input" IsExpanded="True" Margin="8,4">
                                <StackPanel>
                                    <Button Content="⌨️ Set Text" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#66BB6A" Click="AddAction_Click" Tag="SetText"/>
                                    <Button Content="📝 Get Text" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#66BB6A" Click="AddAction_Click" Tag="GetText"/>
                                    <Button Content="☑️ Select" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#66BB6A" Click="AddAction_Click" Tag="Select"/>
                                </StackPanel>
                            </Expander>

                            <!-- Checkbox Actions -->
                            <Expander Header="☑️ Checkbox" IsExpanded="True" Margin="8,4">
                                <StackPanel>
                                    <Button Content="✅ Check" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#FFA726" Click="AddAction_Click" Tag="Check"/>
                                    <Button Content="⬜ Uncheck" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#FFA726" Click="AddAction_Click" Tag="Uncheck"/>
                                </StackPanel>
                            </Expander>

                            <!-- Verification -->
                            <Expander Header="🔍 Verification" IsExpanded="True" Margin="8,4">
                                <StackPanel>
                                    <Button Content="🔍 Verify Text" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#AB47BC" Click="AddAction_Click" Tag="Verify"/>
                                    <Button Content="🔍 Verify Value" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#AB47BC" Click="AddAction_Click" Tag="Verify"/>
                                    <Button Content="🔍 Verify Property" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#AB47BC" Click="AddAction_Click" Tag="Verify"/>
                                </StackPanel>
                            </Expander>

                            <!-- Control Flow -->
                            <Expander Header="⚙️ Control" IsExpanded="True" Margin="8,4">
                                <StackPanel>
                                    <Button Content="⏳ Wait" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#78909C" Click="AddAction_Click" Tag="Wait"/>
                                    <Button Content="📷 Screenshot" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#78909C" Click="AddAction_Click" Tag="Screenshot"/>
                                    <Button Content="🎹 Key Press" Style="{StaticResource ActionButtonStyle}" 
                                            Background="#78909C" Click="AddAction_Click" Tag="KeyPress"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Center Panel: Step Flow -->
            <Grid Grid.Column="1" Margin="16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Test Info -->
                <Border Grid.Row="0" Background="{StaticResource CardBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" 
                        CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Test Name" FontWeight="Bold" FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TestNameBox" Text="{Binding TestName, Mode=TwoWay}"
                                     FontSize="16" Padding="8" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Description" FontWeight="Bold" FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="DescriptionBox" Text="{Binding Description, Mode=TwoWay}"
                                     FontSize="14" Padding="8" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Steps List -->
                <Border Grid.Row="1" Background="{StaticResource CardBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Steps Header -->
                        <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="8,8,0,0" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Test Steps" FontWeight="Bold" FontSize="14" 
                                               VerticalAlignment="Center"/>
                                    <Border Background="{StaticResource PrimaryBrush}" 
                                            CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Steps.Count}" Foreground="White" FontSize="12"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="⬆️" Style="{StaticResource IconButtonStyle}" 
                                            ToolTip="Move Up" Command="{Binding MoveUpCommand}"/>
                                    <Button Content="⬇️" Style="{StaticResource IconButtonStyle}" 
                                            ToolTip="Move Down" Command="{Binding MoveDownCommand}"/>
                                    <Button Content="📋" Style="{StaticResource IconButtonStyle}" 
                                            ToolTip="Duplicate" Command="{Binding DuplicateStepCommand}"/>
                                    <Button Content="🗑️" Style="{StaticResource IconButtonStyle}" 
                                            ToolTip="Delete" Command="{Binding RemoveStepCommand}"/>
                                    <Button Content="🧹" Style="{StaticResource IconButtonStyle}" 
                                            ToolTip="Clear All" Command="{Binding ClearAllCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Steps ListBox -->
                        <ListBox Grid.Row="1" x:Name="StepsListBox"
                                 ItemsSource="{Binding FilteredSteps}"
                                 SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource StepItemStyle}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AllowDrop="True"
                                 Drop="StepsListBox_Drop"
                                 DragOver="StepsListBox_DragOver">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Step Number -->
                                        <Border Grid.Column="0" Background="{StaticResource PrimaryBrush}" 
                                                CornerRadius="12" Width="24" Height="24">
                                            <TextBlock Text="{Binding StepNumber}" Foreground="White" 
                                                       FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Icon -->
                                        <TextBlock Grid.Column="1" Text="{Binding Icon}" 
                                                   FontSize="16" VerticalAlignment="Center"/>

                                        <!-- Description -->
                                        <StackPanel Grid.Column="2" Margin="8,0">
                                            <TextBlock Text="{Binding Description}" 
                                                       FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding ActionType}"/>
                                                <Run Text=" → "/>
                                                <Run Text="{Binding ElementAlias}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Status Indicator -->
                                        <Border Grid.Column="3" Background="{Binding StatusColor}" 
                                                CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="10"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty State -->
                        <StackPanel Grid.Row="1" 
                                    Visibility="{Binding Steps.Count, Converter={StaticResource ZeroToVisibleConverter}}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center"/>
                            <TextBlock Text="No steps yet" FontSize="16" 
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,4"/>
                            <TextBlock Text="Drag actions from the left panel or click to add" 
                                       FontSize="12" Foreground="#9E9E9E"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Footer -->
                        <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="0,0,8,8" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Search Steps -->
                                <TextBox Grid.Column="0" Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border Background="White" CornerRadius="4" Padding="4">
                                                            <Grid>
                                                                <TextBlock Text="🔍 Filter steps..." 
                                                                           Foreground="#9E9E9E"
                                                                           Margin="4,0" VerticalAlignment="Center"
                                                                           Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToVisibleConverter}}"/>
                                                                <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <Button Grid.Column="1" Content="➕ Add Step" 
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="AddStep_Click" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right Panel: Step Properties -->
            <Border Grid.Column="2" Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Step Properties" FontWeight="Bold" 
                               FontSize="14" Margin="12,12,12,8" Foreground="{StaticResource TextPrimaryBrush}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <!-- No Selection Message -->
                            <TextBlock Text="Select a step to edit its properties"
                                       Visibility="{Binding SelectedStep, Converter={StaticResource NullToCollapsedConverter}}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,20"/>

                            <!-- Step Properties (shown when step selected) -->
                            <StackPanel Visibility="{Binding SelectedStep, Converter={StaticResource NullToVisibleConverter}}">
                                <!-- Action Type -->
                                <TextBlock Text="Action Type" FontWeight="Bold" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ActionTypeCombo" 
                                          ItemsSource="{Binding ActionTypes}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding SelectedStep.ActionType, Mode=TwoWay}"
                                          Padding="8" Margin="0,0,0,12"/>

                                <!-- Element Alias -->
                                <TextBlock Text="Element Alias" FontWeight="Bold" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ElementCombo" 
                                          ItemsSource="{Binding AvailableElements}"
                                          DisplayMemberPath="Alias"
                                          SelectedValuePath="Alias"
                                          SelectedValue="{Binding SelectedStep.ElementAlias, Mode=TwoWay}"
                                          IsEditable="True"
                                          Padding="8" Margin="0,0,0,12"/>

                                <!-- Value (for SetText, Select, Wait) -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedStep.ActionType}" Value="Click">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedStep.ActionType}" Value="Hover">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedStep.ActionType}" Value="Verify">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedStep.ActionType}" Value="Check">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedStep.ActionType}" Value="Uncheck">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Value" FontWeight="Bold" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedStep.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8" Margin="0,0,0,12"/>
                                </StackPanel>

                                <!-- Checkpoint Type (for Verify) -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedStep.ActionType}" Value="Verify">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedStep.ActionType}" Value="Check">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedStep.ActionType}" Value="Uncheck">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="Checkpoint Type" FontWeight="Bold" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding CheckpointTypes}"
                                              SelectedItem="{Binding SelectedStep.CheckpointType, Mode=TwoWay}"
                                              Padding="8" Margin="0,0,0,12"/>
                                    
                                    <TextBlock Text="Expected Value" FontWeight="Bold" FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedStep.ExpectedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8" Margin="0,0,0,12"/>
                                </StackPanel>

                                <!-- Robot Code Preview -->
                                <TextBlock Text="Robot Code" FontWeight="Bold" FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4"/>
                                <Border Background="#263238" CornerRadius="4" Padding="8">
                                    <TextBlock Text="{Binding SelectedStep.RobotCode}" 
                                               Foreground="#00E676" FontFamily="Consolas" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Delete Button -->
                                <Button Content="🗑️ Delete Step" 
                                        Style="{StaticResource ActionButtonStyle}"
                                        Background="{StaticResource ErrorBrush}"
                                        Command="{Binding RemoveStepCommand}"
                                        Margin="0,16,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" 
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total Steps: " VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Steps.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text=" | Pending: " VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock Text="{Binding FilteredSteps.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="📊 Flow Diagram" Style="{StaticResource ActionButtonStyle}" 
                            Background="#455A64" Click="ShowFlowDiagram_Click"/>
                    <Button Content="❌ Cancel" Style="{StaticResource ActionButtonStyle}" 
                            Background="#9E9E9E" Click="Cancel_Click"/>
                    <Button Content="✅ Save Test" Style="{StaticResource ActionButtonStyle}" 
                            Background="{StaticResource SuccessBrush}" Click="SaveTest_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
