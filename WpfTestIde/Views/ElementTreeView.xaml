<UserControl x:Class="WpfTestIde.Views.ElementTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WpfTestIde.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <DockPanel Background="{DynamicResource BackgroundBrush}">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🌳" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Element Tree" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="+" ToolTip="Add Folder" Padding="6,2" FontSize="12" 
                            Command="{Binding AddFolderCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource StatusBarTextBrush}" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="➕" ToolTip="Add Element" Padding="4,2" FontSize="10" Margin="4,0,0,0"
                            Command="{Binding AddElementCommand}" Background="{DynamicResource SuccessBrush}" Foreground="{DynamicResource StatusBarTextBrush}" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search Box + D1 filter chip header -->
        <Border DockPanel.Dock="Top" Padding="8">
            <StackPanel Orientation="Vertical">
                <!-- Search row: TextBox + Clear chip + count badge -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍 Search elements..."
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0" VerticalAlignment="Center"
                               Visibility="{Binding SearchFilter, Converter={StaticResource EmptyStringToVisibleConverter}}"/>
                    <TextBox x:Name="SearchBox" Grid.Column="0"
                             Text="{Binding SearchFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8" FontSize="12" AutomationProperties.AutomationId="SearchBox"/>

                    <!-- D1: Clear chip - visible only when SearchFilter is non-empty -->
                    <Button Grid.Column="1" Content="✕" ToolTip="Clear filter"
                            Padding="6,2" Margin="4,0,0,0" FontSize="11"
                            Command="{Binding ClearSearchCommand}"
                            Background="{DynamicResource ButtonBackgroundBrush}" BorderThickness="0" Cursor="Hand"
                            AutomationProperties.AutomationId="btnClearSearch"
                            Visibility="{Binding SearchFilter, Converter={StaticResource EmptyStringToCollapsedConverter}}"/>

                    <!-- D1: count badge - "N elements" or "M / N elements" -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding ElementCountText, Mode=OneWay}"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               AutomationProperties.AutomationId="txtElementCount"/>
                </Grid>

                <!-- D1: "Filter includes parents" toggle - default ON, auto-expands deep matches -->
                <CheckBox Content="Filter includes parents"
                          IsChecked="{Binding FilterIncludesParents, Mode=TwoWay}"
                          FontSize="11" Margin="0,6,0,0"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          ToolTip="When checked, deep matches reveal and auto-expand their ancestor folders (VS Code pattern)"
                          AutomationProperties.AutomationId="chkFilterIncludesParents"/>
            </StackPanel>
        </Border>

        <!-- Expand/Collapse buttons -->
        <Border DockPanel.Dock="Top" Padding="8,0,8,8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnTreeExpandAll" Content="⬇️ Expand All" Padding="6,2" FontSize="11" 
                        Command="{Binding ExpandAllCommand}" Background="{DynamicResource ButtonBackgroundBrush}" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="btnTreeExpandAll"/>
                <Button x:Name="btnTreeCollapse" Content="⬆️ Collapse" Padding="6,2" FontSize="11" Margin="4,0,0,0"
                        Command="{Binding CollapseAllCommand}" Background="{DynamicResource ButtonBackgroundBrush}" BorderThickness="0" Cursor="Hand" AutomationProperties.AutomationId="btnTreeCollapse"/>
            </StackPanel>
        </Border>

        <!-- Tree View -->
        <TreeView x:Name="ElementTreeViewControl" ItemsSource="{Binding RootNodes}" 
                  SelectedItemChanged="ElementTreeViewControl_SelectedItemChanged"
                  BorderThickness="0" Background="Transparent" AutomationProperties.AutomationId="ElementTreeViewControl">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Setter Property="Padding" Value="2"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock VerticalAlignment="Center" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Name}"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ControlType, StringFormat=' ({0})'}" 
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"
                                   Visibility="{Binding ControlType, Converter={StaticResource EmptyStringToCollapsedConverter}}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="📝 Edit Element" Command="{Binding EditNodeCommand}"/>
                    <MenuItem Header="👁️ Preview Element" Command="{Binding PreviewNodeCommand}"/>
                    <Separator/>
                    <MenuItem Header="📋 Copy Alias" Click="CopyAlias_Click"/>
                    <MenuItem Header="🔗 Copy XPath" Click="CopyXPath_Click"/>
                    <Separator/>
                    <MenuItem Header="🗑️ Delete Element" Command="{Binding DeleteNodeCommand}"/>
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
    </DockPanel>
</UserControl>
